# ── Godot 生成目录 ────────────────────────────────────────────────
.godot/
/android/

# ── 素材二进制：不随开源仓库分发 ──────────────────────────────────
# 素材/ 下的 .gd / .tres / .gdshader / .md 是代码和配置，需要进仓；
# 图片、字体、音频只在本机保留。补素材的说明见 素材/README.md。
/素材/**/*.png
/素材/**/*.jpg
/素材/**/*.jpeg
/素材/**/*.webp
/素材/**/*.bmp
/素材/**/*.ttf
/素材/**/*.ttc
/素材/**/*.otf
/素材/**/*.wav
/素材/**/*.mp3
/素材/**/*.ogg
/素材/**/*.ogv
/素材/**/*.import

# 例外：全局字体的导入参数是清晰度真值（antialiasing=0），字体本体补回后直接生效。
!/素材/界面/simsun_原版.ttf.import

# ── 本地运行 / 测试产物 ──────────────────────────────────────────
/.fixture/
/.fixture-play/
/.fixture-*/
/.scratch/
/.backup_*/
/_mutbak/
/_tmp/
/测试/截图/
/测试/差异/
/测试/基线/原版界面/
/测试/*.log
/运行时/

# ── 服务端运行期数据 ─────────────────────────────────────────────
/服务端/runtime/save/
/服务端/runtime/logs/
/服务端/runtime/multiplayer/
/服务端/runtime/www/editor_workspace/backups/
/服务端/runtime/www/editor_workspace/.editor-gm-state.json

