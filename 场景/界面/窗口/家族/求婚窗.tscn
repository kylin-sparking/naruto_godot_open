[node name="说明框" type="RichTextLabel" parent="."]
layout_mode = 0
offset_left = 19.0
offset_top = 199.0
offset_right = 395.0
offset_bottom = 396.0
mouse_filter = 2
bbcode_enabled = true
scroll_active = false
autowrap_mode = 3
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_font_sizes/normal_font_size = 12
theme_override_constants/line_separation = 3
text = "[color=#00ff00]【同生共死】：建立羁绊后您可以与TA一起练级
          组队练级将获得额外的经验加成，与双倍经验符叠加
【魂牵梦萦】：建立羁绊后您可以与TA一起双修
          共同双修将可以获得查克拉精华修炼速度提升的效果
[/color][color=#fff000]【不离不弃】：对方可以对您使用本忍术。忍术效果：
          让您在生命为0时，立即恢复1000以上血量
          免除一次死亡惩罚，并且获得3秒钟的无敌时间
【生死与共】：可以让您获得此忍术的使用能力。忍术效果：
          可以令您将查克拉聚集并一次性迸发，造成巨大伤害
[/color][color=#1e90ff]【如影随形】：您可以随时随地传送到对方身边
【惺惺相惜】：您的羁绊使用药品时，您也获得加成
【羁绊对戒】：属性加成，将让您变得更加强大[/color]"

