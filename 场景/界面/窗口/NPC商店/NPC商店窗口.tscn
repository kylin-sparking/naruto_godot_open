[node name="买卖数量窗" parent="." instance=ExtResource("1_buysale")]

; 商品格的悬停提示。原版 `ShopWindowCell` 挂的是 `MToolTipItem` ——
; 与背包格**同一套**（`MToolTipItem.setValue` 按 ItemData 子类分发：
; `EqpData` → `MToolTipZhuangBei`，其余 → `MToolTipDefault`，`MToolTipItem.as:73-109`），
; 所以这里直接复用背包那两个组件与 `背包窗口._接提示框()`，不另写一份。
[node name="物品提示框" parent="." instance=ExtResource("2_tip")]

