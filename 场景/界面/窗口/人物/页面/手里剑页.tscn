bbcode_enabled = true
text = "[color=#fcc399]当获得手里剑后，在战斗过程中
手里剑会自动触发使用。[/color][color=#00ff00]每次触
发手里剑都会增加其熟练度1点，
当熟练度满时，将会自动提升手
里剑修炼等级。[/color]
[color=#ff0000]当修炼等级满时，需要进行突破
瓶颈操作，才能获得下一阶段的手
里剑。[/color]"
scroll_active = false
autowrap_mode = 2

