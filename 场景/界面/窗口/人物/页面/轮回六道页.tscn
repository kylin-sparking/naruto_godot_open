theme_override_constants/outline_size = 2
text = "如波纹般扩展，忍术起源之
秘！轮回六道拥有像神话一
样的能力，即能创造一切，
亦能极尽破坏。
通过收集野外boss或等级不
弱于自己的其他玩家死亡时
产生的轮回精魄，来修炼轮
回六道。
注：每个玩家每天只能产生
一个轮回精魄。"
autowrap_mode = 2

