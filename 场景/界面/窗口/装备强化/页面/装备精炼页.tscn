; `_ratioMbar`（`MBarExpF`，showTitle=false 且 label 被 removeChild）—— 只有条 + 文字。
; ⚠️ 这里**不用 ProgressBar**：原版 `MBar.setData` 是**遮罩显影**，不是九宫格拉伸 ——
; 它把整幅 `bar`（122 宽）左移，透过固定的 `maskMc`（符号 x=48、宽 94）露出左边一截。
; 换成 ProgressBar 的话，7% 时九宫格会把填充图左边那 4px 圆角当"左帽"画出来，
; 只剩 1px 且发暗的绿（原版是 2px 亮绿）—— 2026-09-23 并排图逐列量出来的。
; 所以这里拆成"槽 + 取区域的填充"，几何照符号算：
;   槽   = barBg  符号(45,3) 100x11 → 材料框局部 (150,57)
;   填充 = maskMc 符号(48,6)  94x5  → 材料框局部 (153,60)，宽度按比例取
[node name="成功率条" type="Control" parent="材料框"]
offset_left = 150.0
offset_top = 57.0
offset_right = 250.0
offset_bottom = 68.0
mouse_filter = 2

[node name="槽" type="TextureRect" parent="材料框/成功率条"]
offset_right = 100.0
offset_bottom = 11.0
expand_mode = 1
stretch_mode = 1
mouse_filter = 2

; ⚠️ `expand_mode = 1`（IGNORE_SIZE）必须开着 —— 不然贴图（122 宽）会把控件的最小尺寸顶成 122，
; 设多少 size 都没用。取区域走 `AtlasTexture`（`TextureRect` **没有** `region_rect`，
; 那是 `Sprite2D` 的属性；写错了只会静默报一句 assignment 错误、然后整段刷新中断）。
[node name="填充" type="TextureRect" parent="材料框/成功率条"]
