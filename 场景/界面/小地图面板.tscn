; 通知条 = 原版 `API.ui.addNotice` → `MessageTipPane`：容器摆在
; (**0.6×宽, 0.6×高**)、文字宽 300 自动换行、左对齐 14 号
; （`UIMain2.as:3512-3513`、`MessageTipPane.as:createTextField`）。
; 以前挂在小地图区域顶上(y=60) 且留在 CanvasLayer 20 ⇒ 既是"地图最上方"、又会被
; 功能窗(110+) 盖住（2026-11-02 用户报「装备打造的信息不要显示在地图最上方」）。
; 单独一层 layer=350：高于功能窗(110+)/头像面板(300)，仍低于模态确认与 Boss 进图确认层(400)。
[node name="通知层" type="CanvasLayer" parent="."]
layer = 350

[node name="通知区域" type="Control" parent="通知层"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="通知条" type="Label" parent="通知层/通知区域"]
visible = false
layout_mode = 0
anchor_left = 0.6
anchor_top = 0.6
anchor_right = 0.6
anchor_bottom = 0.6
offset_right = 300.0
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.88, 0.35, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
