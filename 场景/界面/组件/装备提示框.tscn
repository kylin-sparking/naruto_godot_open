; ⚠️ 明细是 **RichTextLabel 不是 Label** —— 原版 `contentText3` 是 **htmlText**，
; 附加属性那一块**一行里混好几种颜色**（属性行按资质、`追+N` 黄、`【梦幻满值】`绿、抬头橙）。
; Label 一个节点只能一种字色，做不到。
; 现有那些纯文本段（耐久/强化等级/基本属性…）不含 ASCII `[`，原样塞进来就行。
; 高度**不能**再用 `_文字高()` 量（它不认识 BBCode，会把标签也算进去），走 `get_content_height()`。
[node name="明细" type="RichTextLabel" parent="."]
offset_left = 8.0
offset_top = 150.0
offset_right = 288.0
offset_bottom = 230.0
mouse_filter = 2
bbcode_enabled = true
scroll_active = false
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_constants/line_separation = 4
theme_override_font_sizes/normal_font_size = 12

; 镶嵌属性段：抬头一行 + 每颗宝石一行（22x22 图标 + 文字）。
; 行由 `装备提示框.gd` 运行时创建（颗数不定），这里只放一个空容器。
; 稀有段容器：传说属性 / 秘印属性两个 Label + 刻印进度图。
; 做成容器而不是单个 Label，是因为刻印的进度图要按"文字已经排到哪"来定位，
; 而且两者颜色不同（原版传说值按资质、刻印值绿、抬头都橙）。
[node name="稀有明细" type="Control" parent="."]
mouse_filter = 2

