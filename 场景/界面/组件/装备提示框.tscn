; 资质框 + 流光：原版这两层加在**图标**上（`MToolTipZhuangBei.as:172-181`，
; aptitudeIcon (-3,-3)、equipAnimationF (1,1)），而图标在 40x40 的框里居中、位置随图片尺寸动，
; 所以真实位置由 `装备品质.挂覆盖层(_图标框, 实例, false, "提示框", _图标.position)` 每次算。
; 这里烘的是**34x34 图标**（原版物品图就是这个尺寸）时的结果：
;   资质框 = 图标 (3,3) + 偏移 (-3,-3) = (0,0)，尺寸 42x42；
;   流光   = 图标 (3,3) + 偏移 (1,1) + 尺寸一半 (17.5,17.5) = (21.5,21.5)，尺寸 35x35。
; 两者默认 `visible = false` —— 空白提示框/非装备任何时候都不该有框，编辑器与运行时一致。
[node name="资质框" type="TextureRect" parent="图标框"]
visible = false
offset_right = 42.0
offset_bottom = 42.0
mouse_filter = 2

[node name="流光" type="AnimatedSprite2D" parent="图标框"]
visible = false
position = Vector2(21.5, 21.5)
script = ExtResource("7_glow")

[node name="破碎" type="TextureRect" parent="图标框"]
visible = false
offset_right = 25.0
offset_bottom = 16.0
mouse_filter = 2
texture = ExtResource("4_broken")
