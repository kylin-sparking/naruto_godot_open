[gd_scene load_steps=1 format=3]

; 原版「荣誉类」页签里的一行 —— `com/mxw/uifl/controls/cashShop/RongYuItemCell.as`。
; 行高固定 **62**（`:36 _height`，`setSize()` 是**空函数** `:103-105` ⇒ 面板给的宽高一律无效），
; 宽 592（= 分隔线宽，`:67`）。
;
; 坐标全是 AS3 的**行局部**坐标，逐行对得上 `init()`（`:50-92`）：
;   itemIcon          MGrid_background  @ (10,10)  40x40      ← `:54-57`
;   图标(格内)         PicTool.getItemPic @ (3,3)   34x34      ← `:184` `icon.x = icon.y = 3`
;   itemNameText      MLabel UI_BLUE   setLabel(55, 12, 117, 18) → 容器 (55,10) 117x18
;   saleLabel         MLabel UI_GREEN  setLabel(55, 30,  43, 18) → 容器 (55,28)  43x18  文案「荣誉：」
;   salePriceText     MLabel UI_WHITE  setLabel(90, 30,  48, 18) → 容器 (90,28)  48x18
;   iteminfoBox       Box              @ (175,0) 355x58        ← `:76-80`
;   itemInfo          TextField(350x54)                        ← `:81-88`
;   buyBtn            MButtonF         @ (532,22) 宽 btn_width_two=37，文案「兑换」
;   分隔线             LineHPicF        @ (0,60)   592x2       ← `:64-69`
;
; ⚠️ 三处跟「商城商品行.tscn」**不一样**，别顺手照抄那一行：
;   1. **纵向差 6 像素**：`setLabel()`（`:136-144`）写 `y = 传入y - 2`，本行传的是 12/30/30
;      ⇒ 容器落点 10/28/28；`CashItemCell` 传的是 6/22/22 ⇒ 4/20/20，且它在没有原价行时
;      还会运行时把名称压到 12、售价压到 30（`:225-229`）。**终值看着接近，起点的行不一样。**
;   2. **没有**原价行、元宝/券图标、热卖/打折角标 —— `RongYuItemCell` 根本没创建这些控件。
;   3. 售价文案是 `SALE_RONGYU_LABEL`＝「荣誉：」（不是「售价：」），按钮是「兑换」（不是「购买」）。
;
; ⚠️ MLabel 默认字号 **12**（`MLabel.as:218-219`），本行所有文字显式 12。
; ⚠️ `兑换` 在构造时是 `enabled = false`（`:90`），只有 `data` setter 走完才置 true（`:194`）
;    ⇒ 本场景保持 `disabled = true`，由 `社交窗口._布置荣誉行()` 打开。运行时宽度（荣誉值 = 文字宽 + 3）
;    和说明框的垂直居中都在那函数里，别在场景里写死。

[node name="荣誉商品行" type="Panel"]
custom_minimum_size = Vector2(592, 62)
offset_right = 592.0
offset_bottom = 62.0
mouse_filter = 2
theme_type_variation = &"OrigBlankPanel"

