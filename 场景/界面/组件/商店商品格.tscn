[gd_scene load_steps=3 format=3]

; 原版 NPC 商店的商品格 —— `com/mxw/uifl/controls/cell/ShopWindowCell.as`（207 行）。
;
; 尺寸 **110x41** 不是源码里的常数，是**子件包围盒**推出来的（`init()` `:67-109`）：
;   itemIcon  MGrid_background @ (0,0) 40x40
;   coinBg    MTextInput_background @ (41,20) 69x21   → 右沿 110
;   coinMc    MIconGoldCoinF @ (42,22) 17x17
;   itemName  TextField @ (41,3) 63x16（autoSize=LEFT，实际宽随文字）
;   itemPrice TextField @ (61,23) 46x16（同上）
; 最右是 coinBg 的 41+69 = **110**，最下是 coinBg 的 20+21 = **41**。
; `ShopWindow2.initCellCount()`（`:279-313`）就是拿这两个数排网格的：
;   列 x = 6 / width+6 = 116（hgap=6）   行 y = 3 / height+3 的倍数 = 3/44/88/132…（vgap=3）
;
; ⚠️ 名称与价格是**裸 TextField**（不是 MLabel），所以字号取 `_loc1_` 那个 TextFormat 的
;    **12**、颜色白、带 `BaseUtil.getGlowFilter(0)` 描边 —— **没有** MLabel 的 -2/+2 换算。
;
; 文字规则：白字 + 黑描边 3 由主题兜住，场景里不写 override。

[ext_resource type="Texture2D" path="res://素材/界面/原版窗口/通用控件/金币.png" id="1_coin"]
[ext_resource type="Texture2D" path="res://素材/界面/原版窗口/通用控件/禁装.png" id="2_forbid"]

