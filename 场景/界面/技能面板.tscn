[sub_resource type="Shader" id="Shader_yh3av"]
code = "shader_type canvas_item; uniform sampler2D mask_texture; uniform float progress : hint_range(0.0, 1.0) = 0.35; void fragment() { vec4 source = texture(TEXTURE, UV); float mask_alpha = texture(mask_texture, UV).a; float fill_alpha = step(UV.x, progress); COLOR = vec4(source.rgb, source.a * mask_alpha * fill_alpha); }"

