## 五个可勾选特效。原版 `UIConfig.lingQiEffect*Enabled` 全部默认 false，
## 且**只活在客户端内存里**：窗口 `applySelectedEffectsToConfig` 写静态值，
## 退出客户端即回到 false（不落存档、不发给服务端）。
static var 呼吸明暗 := false
static var 外发辉光 := false
static var 斜向流光 := false
static var 边缘星闪 := false
static var 雾化底辉 := false


static func 颜色(id: int) -> Array:
	for 行 in 颜色表:
		if int(行[0]) == id:
			return 行
	return []


## id <= 0 ⇒ 原版 `getLingQiColorTransform` 返回 null（不套颜色），这里给恒等。
static func 颜色变换(id: int) -> Dictionary:
	var 行 := 颜色(id)
	if 行.is_empty() or id <= 0:
		return {"r": 1.0, "g": 1.0, "b": 1.0,
				"ro": 0.0, "go": 0.0, "bo": 0.0}
	return {"r": float(行[1]), "g": float(行[2]), "b": float(行[3]),
			"ro": float(行[5]) / 255.0, "go": float(行[6]) / 255.0,
			"bo": float(行[7]) / 255.0}


## 窗口打开时记下的起点；关窗时没提交的勾选要还原成它。
static func 快照() -> Dictionary:
	return {
		"呼吸明暗": 呼吸明暗, "外发辉光": 外发辉光, "斜向流光": 斜向流光,
		"边缘星闪": 边缘星闪, "雾化底辉": 雾化底辉,
	}


static func 恢复(值: Dictionary) -> void:
	呼吸明暗 = bool(值.get("呼吸明暗", false))
	外发辉光 = bool(值.get("外发辉光", false))
	斜向流光 = bool(值.get("斜向流光", false))
	边缘星闪 = bool(值.get("边缘星闪", false))
	雾化底辉 = bool(值.get("雾化底辉", false))


static func 任意启用() -> bool:
	return 呼吸明暗 or 外发辉光 or 斜向流光 or 边缘星闪 or 雾化底辉
