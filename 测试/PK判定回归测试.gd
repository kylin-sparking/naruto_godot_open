extends SceneTree
## `脚本/角色/PVP判定.gd` 的**判定表门**（#352/#353，2026-10-25）。
##
## 为什么必须有这一道：那颗钮与那张四行菜单已经逐件对过原版，但"切了模式到底能不能打人"
## 全在这个模块的分支顺序里 —— 而它是**纯函数**，最能被表驱动钉死：
## 每一行给一组输入，同时钉 `可打` 与 `话` 两个输出（只钉一个会漏："能打但说错话"、
## "不能打但一声不吭"这两种坏法都过得去）。
##
## 参照值怎么来的（不许问被测对象要）：
## * 三个数（45 / 15 / 安全图 5 张含 100000000）是原版 GameData `Pvp/open` 的**字面值**，
##   下面 `钉值` 一段直接把它们当常数写死 ⇒ 哪天 `数据/PVP配置.json` 被改歪，这条会红。
## * 期望的 `可打`/`话` 是**按 AS3 分支顺序手推**出来的 —— 行号全部来自**实机那份**
##   `as3_MainLib/scripts/com/mxw/game/world/handlers/PVPHandler.as`
##   （`canAttackPlayer:313-381` / `getNoAttackWarning:392-453`），不是跑一遍被测函数抄下来的。
## * ⚠ 本门 10-25 当晚被推倒重写过一次：第一版照的是 `as3_MainLib_plain`（**另一个 build**，
##   源文件 `MainLib_plain.swf` == `MainLib_pvp.swf`，4,393,375 字节，07-25）。那一份
##   没有护送闸、switch 里没有阵营档、3v3 组里没有忍者3v3、两道保护在最前而不是最后，
##   还有三句文案字面不同。玩家实际加载的是 `asset/MainLib.swf`（2,151,305 字节，md5 `3ef4ccb4…`，
##   两份 manifest 都登记成 `asset/MainLib.swf`）⇒ 真值认 `as3_MainLib`（1898 个脚本）。
##   证据链与两份的逐条差异写在 `真值/系统/PK判定.md` §1；标 ★ 的行就是**只有实机这份才成立**的
##   那几条（换成 `_plain` 那份语义它们必然红），用来钉住"别再照错的那份改回去"。
## * 那 13 句文案的原文比对在 `真值/系统/PK判定.md` §4 用机器逐字做过（13/13 全等）。
##   这里只判"该说哪一句"，不重抄字面（重抄 = 把同一份真值抄第二遍）。
##
## 跑法：`Godot --headless --path . --script res://测试/PK判定回归测试.gd`

const 判定 := preload("res://脚本/角色/PVP判定.gd")
const 配置路 := "res://数据/PVP配置.json"

## 原版 `Pvp/open` 的字面值（实机那份在 `PVPHandler.as:95-111` 读的就是这几个键）
const 钉_PK等级 := 45
const 钉_等级差 := 15
const 钉_切面板等级 := 40
const 钉_安全图 := [100000000, 101010000, 101020000, 101030000, 101040000]
const 钉_无保护图数 := 10
const 木叶村 := 100000000
const 非安全图 := 200000000

var _红: Array = []
var 判数 := 0
var 条数 := 0


func _initialize() -> void:
	_跑()
	print("PK判定门：判 %d 条 / 红 %d 条（%s）" % [
		判数, _红.size(), "通过" if _红.is_empty() else "失败"])
	for 项 in _红:
		printerr("  !! " + 项)
	quit(0 if _红.is_empty() else 1)


func _查(过: bool, 文: String) -> void:
	判数 += 1
	if not 过:
		_红.append(文)


## 输入用**具名覆盖**拼，不许用一长串位置参数（本工程栽过 `bind` 实参错位：#327）。
## 缺省值 = "这一档拿不到"（护送旗/双倍、同阵营、两道保护、打架旗都是服务端 buff 或活动态推的，
## 本工程还没接 ⇒ 生产端传不传都行，这里给齐 false，行里只写与该行有关的那几项）。
func _我(等级: int, 图号: int, 覆盖 := {}) -> Dictionary:
	var 底 := {"等级": 等级, "图号": 图号, "同队": false, "同族": false, "同阵营": false,
			"仇人": false, "在3v3": false, "在忍者3v3": false, "在战场": false,
			"在跨服": false, "死亡": false, "护送双倍": false}
	## ⚠ `merge` 的第二参 `cover` **默认 false** ⇒ 已有键不会被覆盖。这里每个键都在 `底` 里
	## 先写了 false，少一个 `true` 就是**所有覆盖项静默失效**（整表变成"全默认"输入，
	## 一大半行退化成 0 比 0）。本门 10-25 当晚就是这么红了 11 条才逮到的。
	底.merge(覆盖, true)
	return 底


func _标(等级: int, 覆盖 := {}) -> Dictionary:
	var 底 := {"等级": 等级, "死亡": false, "复活保护": false, "挂机保护": false,
			"打架旗": false, "护送旗": false}
	底.merge(覆盖, true)
	return 底


## 一行 = 一组输入 + 期望的 `可打`；`可打=false` 时再钉"该说哪一句"（`"‹空串›"` = 必须一声不吭）。
## ⚠ `可打=true` 的行**不判话**：原版只在"打不了"那一刻才问 `getNoAttackWarning`
## （`SkillExecute.as:357-364` 是 `if(canAttack){…} else {addNotice(getNoAttackWarning(…))}`）
## ⇒ 能打的时候那句是什么，原版永远不会显示，钉它就是把我的猜测当原版。
## 要单独判"可打=true 时那句话"的，一律另起一条 `_查(打不了的话(…) == …)` 写明判的是原函数。
func _一行(说明: String, 模式: int, 我: Dictionary, 标: Dictionary,
		期望可打: bool, 期望话: String) -> void:
	条数 += 1
	var 得: Dictionary = 判定.判定(模式, 我, 标)
	var 可打: bool = bool(得.get("可打", not 期望可打))
	var 话: String = String(得.get("话", "‹没这个键›"))
	_查(可打 == 期望可打, "%s ⇒ 可打 期望 %s 实得 %s" % [说明, str(期望可打), str(可打)])
	if 期望可打:
		return
	if 期望话 == "‹空串›":
		_查(话 == "", "%s ⇒ 话 期望空串 实得「%s」" % [说明, 话])
	else:
		## 期望值要**过一遍 `填数`** 再比：原版那两句带 `1%` 的在 AS3 里就是
		## `.replace("1%", minPkLevel)`（`:438/442`）⇒ 屏幕上落的是「很抱歉45级…」。
		var 期: String = 判定.填数(String(判定.话.get(期望话, "‹键不存在›")), 钉_PK等级)
		_查(话 == 期, "%s ⇒ 话 期望 %s 那句 实得「%s」" % [说明, 期望话, 话])


func _跑() -> void:
	# ── ⓪ 量具自检：`_我/_标` 的覆盖项必须真的落进去（否则整表退化成"全默认"输入，
	#    一大半行变成 0 比 0 空判 —— 下面每条 ★ 都不成立了）
	_查(bool(_我(50, 非安全图, {"同队": true, "护送双倍": true}).get("同队", false))
			and bool(_我(50, 非安全图, {"护送双倍": true}).get("护送双倍", false)),
			"量具自检：_我 的覆盖项要真的生效（merge cover=true）")
	_查(bool(_标(50, {"护送旗": true}).get("护送旗", false))
			and bool(_标(50, {"打架旗": true}).get("打架旗", false))
			and not bool(_标(50, {"打架旗": true}).get("护送旗", false)),
			"量具自检：_标 的覆盖项要真的生效、且不许把别的键一起点亮")

	# ── ① 配置表本身：数值与原版字面值一对一，且**图号按数值比**（json 读回来是 float）
	var 配: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(配置路))
	_查(int(配.get("pkLevel", -1)) == 钉_PK等级,
			"pkLevel = %d（原版 Pvp/open）实得 %s" % [钉_PK等级, str(配.get("pkLevel", "‹缺›"))])
	_查(int(配.get("player2playerLevel", -1)) == 钉_等级差,
			"player2playerLevel = %d 实得 %s" % [钉_等级差, str(配.get("player2playerLevel", "‹缺›"))])
	_查(int(配.get("configLevel", -1)) == 钉_切面板等级,
			"configLevel = %d 实得 %s" % [钉_切面板等级, str(配.get("configLevel", "‹缺›"))])
	var 安全: Array = 配.get("peaceMaps", []) as Array
	_查(安全.size() == 5, "peaceMaps 5 张 实得 %d" % 安全.size())
	_查(int(安全[0]) == 木叶村, "peaceMaps 第一张 = %d（木叶村）实得 %s" % [木叶村, str(安全[0])])
	_查(配.get("unprotectedMaps", []) is Array
			and (配["unprotectedMaps"] as Array).size() == 钉_无保护图数,
			"unprotectedMaps %d 张（BOSS 图）实得 %s" % [钉_无保护图数, str(配.get("unprotectedMaps", "‹缺›"))])
	## 10-25 子代理接线上第一版就栽在这里：json 里的数是 **float**，
	## `Array.has(100000000)`（int）恒 false ⇒ "安全图禁止 PK"这道闸看着在、其实永远不拦。
	_查(判定.是安全图(木叶村), "是安全图(%d) 必须为真（int 传进来）" % 木叶村)
	_查(typeof(安全[0]) == TYPE_FLOAT,
			"peaceMaps 里存的必须是 float（json 读回来就这样 ⇒ 只有按数值比才拦得住；"
			+ "如果哪天它变成 int，说明数据链改了，这条要跟着重看）")
	_查(not 判定.是安全图(非安全图), "是安全图(%d) 必须为假" % 非安全图)
	_查(判定.是无保护图(104040000), "是无保护图(104040000)（BOSS 图，unprotectedMaps 里）")
	## 键齐不齐：实机那份两个函数一共引用 13 句，少一句就是照错了 build（`_plain` 那份没有护送/阵营）
	for 键 in ["死亡", "护送", "复活保护", "安全图", "低于我等级差", "和平模式", "对方等级低",
			"同队", "高于我等级差", "同阵营", "我等级低", "挂机保护", "同族"]:
		_查(判定.话.has(键), "话 表里要有「%s」这一句（实机那份 core 包有）" % 键)

	# ── ② 模式四档 + 阵营（`PVPHandler.as:340-359` 的 switch；最后一个 case 没有 break）
	_一行("和平模式 + 非安全图 + 双方 50 级", 判定.和平, _我(50, 非安全图), _标(50), false, "和平模式")
	_一行("组队模式 + 不同队", 判定.组队, _我(50, 非安全图), _标(50), true, "‹空串›")
	_一行("组队模式 + 同队", 判定.组队, _我(50, 非安全图, {"同队": true}), _标(50), false, "同队")
	_一行("家族模式 + 不同族", 判定.家族, _我(50, 非安全图), _标(50), true, "‹空串›")
	_一行("家族模式 + 同族", 判定.家族, _我(50, 非安全图, {"同族": true}), _标(50), false, "同族")
	## ★ 阵营(5)：实机那份 switch **有这一档**（`:355`）⇒ 同阵营打不了；
	## `_plain` 那份没有 ⇒ 换成那一份，这一行会判"可打"而红。
	_一行("★ 阵营模式 + 同阵营 ⇒ 不可打（`:355-359` 有这一档）",
			判定.阵营, _我(50, 非安全图, {"同阵营": true}), _标(50), false, "同阵营")
	_一行("阵营模式 + 不同阵营 ⇒ 没有 case 命中，继续往下",
			判定.阵营, _我(50, 非安全图), _标(50), true, "‹空串›")
	## ⚠ 全体模式**不保护队友**（打错队友本来就是原版的惩罚）⇒ 全体 + 同队 必须"可打"。
	## 写成"不可打"就是又造了一条原版没有的闸（这一条上一轮我在服务端自造过，已删）。
	_一行("全体模式 + 同队（原版不保护队友）", 判定.全体, _我(50, 非安全图, {"同队": true}), _标(50), true, "‹空串›")
	_一行("全体模式 + 同族（家族 case 不拦全体）", 判定.全体, _我(50, 非安全图, {"同族": true}), _标(50), true, "‹空串›")
	_一行("★ 全体模式 + 同阵营（阵营 case 只在阵营档生效）",
			判定.全体, _我(50, 非安全图, {"同阵营": true}), _标(50), true, "‹空串›")
	## 同队 + 又在木叶村：switch（`:344`）**先于**图闸（`:364`）⇒ 说的是组队那句，不是「本地图禁止PK」。
	## 谁把两道闸换了个儿，这一行就红。
	_一行("★ 组队模式 + 同队 + 在木叶村 ⇒ 说组队那句（switch 先于图闸）",
			判定.组队, _我(50, 木叶村, {"同队": true}), _标(50), false, "同队")

	# ── ③ 等级闸（`pkLevel=45`，两边各判一次；`:368` / `:372`）
	_一行("我方 44 级", 判定.全体, _我(44, 非安全图), _标(50), false, "我等级低")
	_一行("我方 45 级（`<` 不是 `<=`）", 判定.全体, _我(45, 非安全图), _标(50), true, "‹空串›")
	_一行("对方 44 级", 判定.全体, _我(50, 非安全图), _标(44), false, "对方等级低")
	_一行("对方 45 级", 判定.全体, _我(50, 非安全图), _标(45), true, "‹空串›")
	## ★ 实机这份那句带的是 `1%` ⇒ **会**被 replace 成 45；`_plain` 那份写的是 `%1`（换不掉）。
	## 这一条钉的是"别照错的那份把占位符改回去"。
	_查(判定.填数(String(判定.话["我等级低"]), 钉_PK等级).find("45") >= 0,
			"「我等级低」那句里的 1% 必须换成 45（实机那份 core 包 :61 写的是 1%）")
	_查(判定.填数("前1%后", 45) == "前45后", "填数 只认字面 `1%`（原版 .replace(\"1%\",…)）")
	## 等级差 15 是**服务端**那一道（`pkLevelScope` 读进来后这个类再没用过）⇒ 这边必须判"可打"，
	## 但 `等级差话()` 要能给出那两句之一。两个都钉，才不会出现"客户端拦了原版不拦的"。
	_一行("差 16 级：客户端仍可打（等级差是服务端的闸）",
			判定.全体, _我(61, 非安全图), _标(45), true, "‹空串›")
	_查(判定.等级差话(61, 45).length() > 0, "等级差话(61,45) 要给一句（打低于我 15 级以上）")
	_查(判定.等级差话(45, 61).length() > 0, "等级差话(45,61) 要给一句（打高于我 15 级以上）")
	_查(判定.等级差话(60, 45) == "", "等级差正好 15 ⇒ 不说话（`>` 不是 `>=`）")

	# ── ④ 安全图（`:360-367`：先"目标在打架态 ⇒ 直接可打"，再判本图是否安全图）
	_一行("非安全图 目标没打架 ⇒ 走等级闸 ⇒ 可打", 判定.全体, _我(50, 非安全图), _标(50), true, "‹空串›")
	_一行("安全图（木叶村）+ 目标没打架 ⇒ 禁止 PK", 判定.全体, _我(50, 木叶村), _标(50), false, "安全图")
	_一行("安全图 + 目标在打架态 ⇒ 可打（`:360` 那条 return true 在图闸之前）",
			判定.全体, _我(50, 木叶村), _标(50, {"打架旗": true}), true, "‹空串›")
	_一行("安全图 + 和平模式 ⇒ 先说和平那句（switch 在图闸之前）",
			判定.和平, _我(50, 木叶村), _标(50), false, "和平模式")

	# ── ⑤ 保护与死亡（★ 实机这份把两道保护放在**最后**：`可打玩家:376` / `的话:444,448`）
	_一行("目标复活保护（全体、够级）⇒ 走到底被保护拦",
			判定.全体, _我(50, 非安全图), _标(50, {"复活保护": true}), false, "复活保护")
	_一行("目标挂机（夜间）保护", 判定.全体, _我(50, 非安全图), _标(50, {"挂机保护": true}), false, "挂机保护")
	_一行("★ 和平模式 + 目标带复活保护 ⇒ 说和平那句（保护那道在最后，轮不到）",
			判定.和平, _我(50, 非安全图), _标(50, {"复活保护": true}), false, "和平模式")
	_一行("★ 等级不够 + 目标带复活保护 ⇒ 说等级那句（还是轮不到保护）",
			判定.全体, _我(20, 非安全图), _标(50, {"复活保护": true}), false, "我等级低")
	_一行("目标已死 ⇒ 可打（`可打玩家` 不判死亡，判在 `SkillHandler.canAttack`）",
			判定.全体, _我(50, 非安全图), _标(50, {"死亡": true}), true, "‹空串›")
	_一行("目标已死 + 和平 ⇒ 一声不吭（`的话:398` 那句先 return \"\"）",
			判定.和平, _我(50, 非安全图), _标(50, {"死亡": true}), false, "‹空串›")
	## 上面两行是**故意**钉"可打与话不一致"：调用方必须两个都问 ——
	## 只信 `可打` 会对着尸体出手、只信 `话` 会把和平模式当成"能打"。
	_查(判定.打不了的话(判定.全体, _我(50, 非安全图, {"死亡": true}), _标(50))
			== String(判定.话["死亡"]),
			"★ 我方已死 ⇒ 说死亡那句（`API.player.isDie:402` 在 switch 与保护之前）")
	_查(判定.打不了的话(判定.全体, _我(50, 非安全图, {"死亡": true}), _标(50, {"复活保护": true}))
			== String(判定.话["死亡"]),
			"★ 我方已死 + 目标带复活保护 ⇒ 还是死亡那句（我死 :402 早于保护 :444）")
	## 双方都死时**目标那一句先 return ""**（`:398` 早于 `:402`）⇒ 一声不吭。
	## 这条是 10-25 变异 M6（把两句顺序换过来）逮出来的：漏了它，"我死那句"怎么挪门都不红。
	_查(判定.打不了的话(判定.全体, _我(50, 非安全图, {"死亡": true}), _标(50, {"死亡": true}))
			== "",
			"双方都死 ⇒ 空串（目标 isDead :398 在我方 isDie :402 之前）")

	# ── ⑥ 3v3 / 忍者3v3 / 战场 / 跨服（`可打玩家:323-333` 在 switch **之前** return）
	_一行("3v3 + 和平模式 ⇒ 可打（这一段先于模式 switch，是它自己的规矩）",
			判定.和平, _我(50, 木叶村, {"在3v3": true}), _标(50), true, "‹空串›")
	_一行("3v3 + 同队 ⇒ 不可打（只有这两种 3v3 里保护队友）",
