extends SceneTree
## 宠物数值引擎回归 —— 钉 `脚本/角色/宠物数值.gd` 逐式搬运 `PetAddValue.as` 的结果。
##
## 期望值全部由 **Python 独立镜像** 算出（对源码 :80-251 逐式重算），不是从引擎"跑一遍抄回来"
## —— 防 §3.61.3 那种"两边一起错"。输入用刻意不对称的潜力组合（896/850/784/940 + total 全 922），
## 相等值会掩盖 real/total 与 atk/def/dex/str 的错位。
##
## ⚠️ 梦幻度**两套口径**是原版自带的，不是 bug：
##   显示值（本引擎）：四个分量**各自截断再相加**（PetAddValue:385-388, 400-403）→ 40
##   融魂门槛（服务端 `_pet_total_dream_score` :48559）：浮点**和**再截断 → 42
## 两边公式在"分母混用 real 的 def/str"这点上倒是一致（疑似同源笔误），都照搬不"修正"。

const 宠物数值 := preload("res://脚本/角色/宠物数值.gd")

var _fails: Array[String] = []

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var 宠 := {
		"item_id": 104, "name": "4阶忍犬", "level": 41, "savvy": 37, "aptitude": 4,
		"potential_real_atk": 896, "potential_real_def": 850,
		"potential_real_dex": 784, "potential_real_str": 940,
		"potential_total_atk": 922, "potential_total_def": 922,
		"potential_total_dex": 922, "potential_total_str": 922,
		"ling_zhu": 4, "experience": 12345,
		"skills": [{"id": 103, "level": 5}, {"id": 201, "level": 3}],
	}
	var 算 := 宠物数值.计算(宠)
	# —— 8 属性行（白值 + 梦幻绿值），逐行打实际值
	var 期望 := {
		"增加主人生命值": [954, 401], "增加主人查克拉": [204, 85],
		"增加主人攻击": [292, 122], "增加主人防御": [239, 100],
		"增加主人暴击": [23, 9], "增加主人闪避": [252, 105],
		"增加主人攻速": [85, 35], "增加主人移速": [12, 5],
	}
	var 行: Array = 算["属性行"]
	for 号 in 8:
		var 项: Dictionary = 行[号]
		print("  %s = %d +%d" % [项["名"], 项["值"], 项["梦幻加成"]])
		var 期: Array = 期望.get(String(项["名"]), [null, null])
		_查(int(项["值"]) == int(期[0]), "%s 白值 %d ≠ 期望 %s" % [项["名"], 项["值"], 期[0]])
		_查(int(项["梦幻加成"]) == int(期[1]), "%s 绿值 %d ≠ 期望 %s" % [项["名"], 项["梦幻加成"], 期[1]])
	# —— 梦幻度：显示口径四分量 + 倍率（0.42029 = 0.37/10 截 0.037→3 …见 Python 镜像）
	var 分量: Dictionary = 算["梦幻分量"]
	_查(int(分量["wu_xing"]) == 3, "悟性梦幻 %s" % 分量["wu_xing"])
	_查(int(分量["qian_li"]) == 31, "潜力梦幻 %s" % 分量["qian_li"])
	_查(int(分量["skill"]) == 2, "技能梦幻 %s" % 分量["skill"])
	_查(int(分量["ling_zhu"]) == 4, "灵珠梦幻 %s" % 分量["ling_zhu"])
	_查(int(算["梦幻度"]) == 40, "总梦幻（显示口径）%s ≠ 40" % 算["梦幻度"])
	_查(absf(float(分量["multiplier"]) - 0.42029) < 1e-9, "倍率 %s ≠ 0.42029" % 分量["multiplier"])
	# —— 存量直显与价
	_查(int(算["潜力总值"]) == 3470, "潜力总值 %s" % 算["潜力总值"])
	_查(int(算["价值"]) == 3607, "价值 %s ≠ 3470+37+2×50=3607（§3.61 对照图同型公式）" % 算["价值"])
	_查(int(算["经验上限"]) == 29538, "expTable[41] %s" % 算["经验上限"])
	var 条: Array = 算["潜力条"]
	_查(String(条[3]["名"]) == "健体潜力" and int(条[3]["实"]) == 940 and int(条[0]["实"]) == 896,
		"潜力条 real 错位：%s" % [条])
	_查(int(条[0]["上限"]) == 922, "apt4 潜力上限 %s" % 条[0]["上限"])
	# —— 名字与品质
	_查(String(算["名字"]) == "4阶忍犬(稀有)", "显示名 %s" % 算["名字"])
	_查(算["名字色"] == Color("#9102ff"), "稀有品质色 %s" % [算["名字色"]])
	_查(宠物数值.是尾兽(404) and not 宠物数值.是尾兽(104), "尾兽判定")
	_查(String(宠物数值.显示名({"item_id": 404, "name": "九尾(九喇嘛)", "aptitude": 4})) == "九尾(九喇嘛)",
		"尾兽显示名不该追加品质")
	_查(宠物数值.品质色_of(2) == Color("#08ff19") and 宠物数值.品质色_of(5, true) == Color("#ffff00"),
		"品质色表")
	# —— 技能加成是**覆盖式**（同类型后者胜，FightValue case 是赋值不是 +=）
	var 双 := 宠物数值.技能加成({"skills": [{"id": 201, "level": 3}, {"id": 201, "level": 7}]})
	_查(int(双["MHPR"]) == 7, "同类型应覆盖为 1×7=%s" % 双["MHPR"])
	# —— 暴击阈值是六式里唯一的 1000（其余 1400）。主输入的 784 越不过任一阈值，
	#    反向对照（把 1000 抄成 1400）不会红 —— 得用跨过 (1000,1400] 的值钉**具体数字**：
	#    1200 → 正确折算成 1100 再算 = 13；阈值若错写成 1400（不折算）= 15。
	_查(宠物数值.caculate_baoji(1200, 1) == 13, "暴击阈值 1000 的折算没生效（1200 应得 13，抄成 1400 会得 15）")
	_查(宠物数值.caculate_baoji(1500, 1) == 16, "暴击 >1000 第二段折算（1500 应得 16）")
	# —— 主动技能 103 没有 type_attr → 不进加成
	_查(int(宠物数值.技能加成({"skills": [{"id": 103, "level": 5}]})["MHPR"]) == 0, "主动技能不该进加成")
	# —— 携带等级（出战门槛用）与空宠
	_查(宠物数值.携带等级(宠) == 30, "4阶忍犬 carryLevel %s" % 宠物数值.携带等级(宠))
	_查(宠物数值.计算({}).is_empty(), "空宠应返回空")

	if _fails.is_empty():
		print("宠物数值回归测试：通过（8 行公式/梦幻双口径/覆盖式加成/品质色 全对）")
		quit(0)
	else:
		for f in _fails:
			push_error("宠物数值回归测试：失败 - %s" % f)
		quit(1)

func _查(ok: bool, msg: String) -> void:
	if not ok:
		_fails.append(msg)
