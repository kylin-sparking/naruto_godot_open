extends SceneTree

## 物品菜单的**逐项对照**回归：把 `CN.as:8254 menuArr` 那 20 套、以及
## `ItemWindow2.filtrateItemMenu`（:505-）的过滤规则钉住。
##
## 期望值有两个来源，**都不是我推的**：
##   1. `menuArr` 直接抄自 `CN.as:8254`（20 套，按 `物品类型ID − 1` 取）
##   2. 下面 `原版实测` 那 6 条是 **2026-09-20 驱动原版真机抓的**菜单
##      （同一个号、同一个格子点开截图读出来的），用来独立校验前一条
##
## 跑法：
##   Godot --headless --path . --script res://测试/物品菜单回归测试.gd

const 菜单 := preload("res://脚本/界面/组件/物品菜单.gd")

var _失败: Array[String] = []
var _检查数 := 0


func _initialize() -> void:
	_查表()
	_查原版实测()
	_查过滤规则()
	print("物品菜单回归测试：%d 项断言" % _检查数)
	if _失败.is_empty():
		print("物品菜单回归测试：通过")
		quit(0)
		return
	for 条 in _失败:
		print("  ✗ ", 条)
	print("物品菜单回归测试：失败 %d 条" % _失败.size())
	quit(1)


func _断言(条件: bool, 说明: String) -> void:
	_检查数 += 1
	if not 条件:
		_失败.append(说明)


## `menuArr` 20 套逐套核（类型号 1..20，下标 = 类型号-1）
func _查表() -> void:
	var 表 := 菜单.菜单项表
	_断言(表.size() == 20, "menuArr 应有 20 套，实际 %d" % 表.size())
	if 表.size() != 20:
		return
	_断言(表[0] == ["佩戴", "移动", "拆分", "销毁", "发到聊天框", "宝石镶嵌", "破碎修复", "强化", "升阶", "镶嵌勾玉"],
		"类型1（装备-玩家）的菜单对不上：%s" % [表[0]])
	_断言(表[1] == ["宠物佩戴", "移动", "拆分", "销毁", "发到聊天框", "宝石镶嵌", "强化"],
		"类型2（装备-宠物）的菜单对不上：%s" % [表[1]])
	# 类型 3..7（HP药/MP药/活力药/技能书-玩家/技能书-宠物）五套完全相同
	for i in range(2, 7):
		_断言(表[i] == ["使用", "全部使用", "移动", "拆分", "销毁", "发到聊天框"],
			"类型%d（药/技能书）的菜单对不上：%s" % [i + 1, 表[i]])
	# 类型 8/9（残卷-玩家/宠物）两套相同
	for i in [7, 8]:
		_断言(表[i] == ["移动", "拆分", "销毁", "发到聊天框", "合成", "绑定"],
			"类型%d（残卷）的菜单对不上：%s" % [i + 1, 表[i]])
	_断言(表[9] == ["移动", "拆分", "销毁", "发到聊天框"], "类型10（任务物品）对不上：%s" % [表[9]])
	_断言(表[10] == ["使用", "全部使用", "移动", "拆分", "销毁", "发到聊天框", "绑定"],
		"类型11（礼包）对不上：%s" % [表[10]])
	_断言(表[11] == ["使用", "全部使用", "移动", "拆分", "销毁", "发到聊天框"],
		"类型12（材料）对不上：%s" % [表[11]])
	_断言(表[12] == ["移动", "拆分", "销毁", "发到聊天框", "重置", "合成", "绑定"],
		"类型13（宝石）对不上：%s" % [表[12]])
	for i in [13, 14]:
		_断言(表[i] == ["使用", "全部使用", "移动", "拆分", "销毁", "发到聊天框"],
			"类型%d（舍利子/特殊物品）对不上：%s" % [i + 1, 表[i]])
	_断言(表[15] == ["移动", "拆分", "销毁", "发到聊天框"], "类型16（辅助物品）对不上：%s" % [表[15]])
	_断言(表[16].is_empty() and 表[17].is_empty(), "类型17/18（神器/Buff物品）应有空表")
	_断言(表[18] == ["移动", "拆分", "销毁", "发到聊天框", "绑定"], "类型19（魂戒）对不上：%s" % [表[18]])
	_断言(表[19] == ["佩戴", "移动", "拆分", "销毁", "发到聊天框", "开光", "灵化", "洗练"],
		"类型20（灵器）对不上：%s" % [表[19]])
	_断言(菜单.回退菜单 == ["移动", "拆分", "销毁", "发到聊天框"],
		"类型超出 20 时的回退菜单对不上：%s" % [菜单.回退菜单])


## 2026-09-20 驱动原版真机抓的 6 个格子（同一号、窗口在 (1230,551)）。
## 期望值是我从截图里**读出来的**，不是从表推的 —— 这一节才真正能证伪上面的表。
func _查原版实测() -> void:
	# 格1：装备-玩家、**变身/时装**（id 第3-4位 "21"）、件数 1、没破碎
	#   → 表[0] 去掉 宝石镶嵌(时装) + 破碎修复(crashTime==0) + 升阶 + 镶嵌勾玉 + 拆分(件数1) = 5 项
	_断言(菜单.取菜单项({"id": "01210001", "quantity": 1}) == ["佩戴", "移动", "销毁", "发到聊天框", "强化"],
		"原版实测·装备那条对不上：%s" % [菜单.取菜单项({"id": "01210001", "quantity": 1})])
	# 格2：药/技能书类、件数≥2、useAll≠1 → 去 全部使用
	_断言(菜单.取菜单项({"id": "03000001", "quantity": 5}) == ["使用", "移动", "拆分", "销毁", "发到聊天框"],
		"原版实测·药那条对不上：%s" % [菜单.取菜单项({"id": "03000001", "quantity": 5})])
	# 格4：礼包、件数≥2、useAll≠1
	_断言(菜单.取菜单项({"id": "11000001", "quantity": 5}) == ["使用", "移动", "拆分", "销毁", "发到聊天框", "绑定"],
		"原版实测·礼包那条对不上：%s" % [菜单.取菜单项({"id": "11000001", "quantity": 5})])
	# 格7/格9：残卷类（8 或 9）
	for 前缀 in ["08", "09"]:
		_断言(菜单.取菜单项({"id": 前缀 + "000001", "quantity": 5})
			== ["移动", "拆分", "销毁", "发到聊天框", "合成", "绑定"],
			"原版实测·残卷%s那条对不上：%s" % [前缀, 菜单.取菜单项({"id": 前缀 + "000001", "quantity": 5})])
	# 格10：特殊物品、useAll==1 → 保留 全部使用
	_断言(菜单.取菜单项({"id": "15000001", "quantity": 5, "use_all": 1}) == ["使用", "全部使用", "移动", "拆分", "销毁", "发到聊天框"],
		"原版实测·特殊物品那条对不上：%s" % [菜单.取菜单项({"id": "15000001", "quantity": 5, "use_all": 1})])


## `filtrateItemMenu`（:505-）的过滤规则
func _查过滤规则() -> void:
	# 件数 == 1 → 去掉「拆分」
	_断言(not 菜单.取菜单项({"id": "03000001", "quantity": 1, "use_all": 1}).has("拆分"), "件数 1 时应当没有「拆分」")
	_断言(菜单.取菜单项({"id": "03000001", "quantity": 2, "use_all": 1}).has("拆分"), "件数 2 时应当有「拆分」")
	# useAll != 1 → 去掉「全部使用」
	_断言(not 菜单.取菜单项({"id": "03000001", "quantity": 2}).has("全部使用"), "useAll≠1 时应当没有「全部使用」")
	# 神器走单独一条（`getItemMenu:617` `isItemAShenQi` 提前 return）——
	# ⚠️ 判据是 **id**（`getTypeFromId == 17`），不是入参：全工程唯一的调用点
	#    （`背包窗口.gd:784`）**写死传 false**，所以这条必须**不传 true** 也成立。
	_断言(菜单.取菜单项({"id": "17000001", "quantity": 1}) == ["佩戴", "移动", "销毁", "发到聊天框"],
		"神器那条对不上（该按 id 判、不看入参）：%s" % [菜单.取菜单项({"id": "17000001", "quantity": 1})])
	_断言(菜单.取菜单项({"id": "17000001", "quantity": 1}, true) == ["佩戴", "移动", "销毁", "发到聊天框"],
		"神器那条对不上（显式传 true 那份）：%s" % [菜单.取菜单项({"id": "17000001", "quantity": 1}, true)])
	# ⚠️ 人具 65 **不是**回退菜单 —— 原版 `getItemMenu:621-624` 给的是写死的六项
	#    `[佩戴, 移动, 拆分, 销毁, 发到聊天框, 开光]`（`ItemType.RenJu = 65`，不在 `menuArr` 里）。
	#    2026-10-13 修：以前这里跟着"65 超出表长 ⇒ 回退"写，把**「开光」入口整个丢了**。
	_断言(菜单.取菜单项({"id": "65000001", "quantity": 5})
			== ["佩戴", "移动", "拆分", "销毁", "发到聊天框", "开光"],
		"类型 65（人具）该走 `getItemMenu` 里那条写死的六项菜单：%s"
			% [菜单.取菜单项({"id": "65000001", "quantity": 5})])
	# 已开光的人具 id 是 **65000002**（`isRenJuKaiGuang:1185`）⇒ 去掉「开光」
	_断言(not 菜单.取菜单项({"id": "65000002", "quantity": 1}).has("开光"),
		"65000002（已开光的人具）不该再出「开光」")
	# 类型超出 20（昆虫 131 / 徽章石 132 / 徽章 141 / 货币 90）→ 回退
	_断言(菜单.取菜单项({"id": "90000001", "quantity": 5}) == ["移动", "拆分", "销毁", "发到聊天框"],
		"类型 90（货币）应走回退菜单")
