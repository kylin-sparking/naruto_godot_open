[gd_resource type="Theme" load_steps=2 format=3]

; 忍术面板的稀疏主题。**只挂字体，不写任何颜色/描边/样式** ——
; 一旦往里写那些，就会遮住 `原版皮肤表` 那三层文字规则在这个面板里的效果
; （§3.38 / §3.41.5 第 12 条），`测试/界面主题回归测试.gd` 会盯着这一点。
;
; ⚠️ 2026-09-27 **字体从微软雅黑改回宋体**（= 全局 `原版字体.tres`）。
;
; 依据是用户给的并排对比图（`忍术界面对比.png`，4 倍放大）：
;   · 原版：字形**实心白**、笔画粗实、外面一圈**很细**的暗描边；
;   · 我们（雅黑）：字形**发灰发透**、笔画细、外面一圈暗晕**把笔画芯吃掉了一部分**。
;
; 原因是字体性质，不是渲染参数：
;   · 宋体 12px 有**内嵌点阵**，笔画本来就是 1~2px 的实心块 → 2px 描边吃不掉它；
;   · 雅黑是纯轮廓，12px 笔画只有 ~1px → 2px 描边一压，芯就没了，只剩晕。
; 而且**原版 `Config.COMMON_FONT` 就是宋体**，这个面板原版也用宋体。
;
; 雅黑是 §3.39（2026-09-26）用户看过合并后字形差别之后选的"只这一个面板用雅黑"，
; 现在有并排证据说明那个选择在观感上站不住，故回到原版口径。
; 要回退：把下面 default_font 换回 `忍术面板字体_雅黑.tres`（那份还留着）。

[ext_resource type="FontFile" path="res://素材/界面/simsun_原版.ttf" id="1_song"]

[resource]
default_font = ExtResource("1_song")
