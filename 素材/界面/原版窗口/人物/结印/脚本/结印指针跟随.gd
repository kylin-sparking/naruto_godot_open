@tool
extends TextureRect
## 结印指针 —— 按现实时间指向对应的印（12 个印 = 表盘 12 个整点）。
##
## 挂在 场景/界面/窗口/人物/页面/结印页.tscn 的 `结印阵/时间指针/结印指针` 上。
##
## 表盘对应关系（由 12 个印的实际坐标实测得出：
## 圆心 (199.2, 144.2)、半径约 120px、相邻两印夹角恰好 30°）：
##   印1  = 12点(0°)     印2  = 1点(30°)    印3  = 2点(60°)    印4  = 3点(90°)
##   印5  = 4点(120°)    印6  = 5点(150°)   印7  = 6点(180°)   印8  = 7点(210°)
##   印9  = 8点(240°)    印10 = 9点(270°)   印11 = 10点(300°)  印12 = 11点(330°)
##
## ★ 指针**只认小时**，不看分秒：11:40 仍然停在 11 点（印12），
##   要等走到 12:00 才换成 12 点（印1）。即角度 = 时 × 30°，
##   整点之间指针是静止的，整点那一刻才动。
##
## 指针素材 `指针.png`(120×24) 的旋转轴在**右端**、指针向左延伸，
## 所以 rotation = 0 时它指向 9 点方向 —— 用下面的 `素材角度补偿` 补掉这 90°。
##
## 轴心不用手动设：`_ready()` 里会自动把 pivot_offset 挪到表盘圆心上。

## 表盘圆心，坐标口径是父节点 `结印阵` 的坐标系。
## 12 个印就是绕这个点排成一圈的；实测半径约 120px。
@export var 圆心 := Vector2(199.2, 144.2)

## 指针素材基准朝向的角度补偿（度）。
## 90 = 素材原本朝向「9 点/正左」，本项目 `指针.png` 就是这种。
## 若换了别的指针素材，把它调到「12 点朝上」为止。
@export var 素材角度补偿: float = 90.0

## 再手工微调几度（一般不用动）。正值 = 顺时针。
@export var 微调角度: float = 0.0

## 整点换位时的过渡方式：
##   true  = 平滑转过去（约 0.5 秒转完这 30°，观感柔和）
##   false = 整点一到，指针瞬间跳到新位置
@export var 平滑跟随 := true

## 平滑速度（仅 平滑跟随 = true 时有效）。越大越快转到位。
@export var 平滑速度: float = 8.0

var _当前角度: float = 0.0
var _目标角度: float = 0.0


func _ready() -> void:
	# 把旋转轴心挪到表盘圆心，否则指针会绕自己的左上角转（画圈 / 甩出去）
	pivot_offset = _圆心在局部坐标()
	_目标角度 = (1 - 1) * 30.0 + 素材角度补偿 + 微调角度
	_当前角度 = _目标角度
	rotation_degrees = _当前角度


func _process(delta: float) -> void:
	# 目标角度由**阶段**决定（`指向阶段()` 设的），这里只负责平滑转过去。
	if 平滑跟随:
		# 必须用 lerp_angle：直接插值在 359°→0° 那一帧会反向甩一整圈
		_当前角度 = rad_to_deg(lerp_angle(
			deg_to_rad(_当前角度), deg_to_rad(_目标角度),
			clampf(平滑速度 * delta, 0.0, 1.0)))
	else:
		_当前角度 = _目标角度
	rotation_degrees = _当前角度


## 让指针**指向某一阶段**（原版只有这一种驱动）。
##
## ⚠️ 2026-09-25 改：原版**不是跟现实时钟**，而是跟玩家的**当前阶段** ——
##   `JieYinPanel.as:460`  `this.zhizhen.rotation = (param1 - 1) * 30 + 90;`
##   调用链：`JieYinManager.onJieYin_showBuffEffect(stage,…)`
##        → `onJieYin_updateZhiZhen(stage)`（`JieYinManager.as:177/104`）
##        → `jieYinPanel.updateZhiZhen(stage)`。
##   也就是**服务端推结印 buff 时才转**（提升成功后）；页面上点某个印
##   （`setStage()`）**只换选中框与属性面板，不动指针**。
##   原版里 `updateZhiZhen` 全项目只有三处引用，没有一处读时间。
##
## ⚠️ 2026-11-01 再改：**当帧到位、不补间**。原版那行是**直接赋值**
##   （`JieYinPanel.as:455-461` 没有任何 TweenLite），而本页每次回帧都会整页重建
##   ⇒ `_ready()` 先把指针摆回印1（90°），再让 `_process` 的平滑 lerp 慢慢转过去，
##   表现就是「提升一次，指针从 0 扫到当前位置」（用户 2026-11-01 报修）。
##   `平滑跟随` 只保留作排查开关，`指向阶段()` 一律写死 `_当前角度`。
func 指向阶段(阶段: int) -> void:
	_目标角度 = (clampi(阶段, 1, 12) - 1) * 30.0 + 素材角度补偿 + 微调角度
	_当前角度 = _目标角度
	rotation_degrees = _当前角度


## 现实时间 → 表盘角度。**原版不用它**（保留只为排查时对照）。
func _表盘角度() -> float:
	var 时间 := Time.get_time_dict_from_system()
	var 时: int = int(时间["hour"]) % 12          # 12 小时制，0~11（12 点记作 0）
	return 时 * 30.0 + 素材角度补偿 + 微调角度


## 表盘圆心换算成本节点的局部坐标（pivot_offset 口径）。
func _圆心在局部坐标() -> Vector2:
	var 父偏移 := Vector2.ZERO
	var 父 := get_parent()
	if 父 is Control:
		父偏移 = (父 as Control).position
	return 圆心 - 父偏移 - position
