const 阶名表 := {1: "基础", 2: "十字", 3: "八方", 4: "长箸", 5: "斩镰", 6: "风魔", 7: "螺旋"}


static func 取阶(阶: int) -> Dictionary:
	return 阶段表.get(阶, {})


static func 本阶等级(阶: int, 全局等级: int) -> int:
	# Flash: getShouLiJianLevel = level - 4*(stage-1)，夹到 1..4 防止越界
	return clampi(全局等级 - 每阶最大等级 * (阶 - 1), 1, 每阶最大等级)


static func 图标路径(阶: int, 本阶: int) -> String:
	return "res://素材/界面/原版窗口/人物/手里剑/手里剑各个阶段/%s手里剑阶段%d.png" % [
		阶名表.get(阶, "基础"), clampi(本阶, 1, 每阶最大等级)]


static func 技能图标路径(技能id: int) -> String:
	return "res://素材/技能/000/skill/Skill_000_skill_%07d.swf_1_Skill_000_skill_%07d_icon.png" % [
		技能id, 技能id]
