extends Control

# ============================================================
# 写轮眼 / 通术 · 阶段切换（1:1 复刻 Flash 原版 RotateFade）
#
# 原版机制（MainLib_plain.swf → swap/RotateFade.as:36-43）：
#   令 p = 已过时间 / 总时长 ∈ [0,1]，numCycle = 2
#     旧眼.alpha     = 1 - p                      ← 边转边淡出
#     新眼.alpha     = p                          ← 边转边淡入
#     旧眼.rotation  = numCycle * 360 * p        →   0° → 720°（顺时针转出）
#     新眼.rotation  = numCycle * 360 * (1 - p)  → 720° →   0°（反向转入）
#
#   ★ 关键：旧眼与新眼「同时存在、同时变化」，
#     同一时刻屏幕上叠着两张半透明的图 —— 这才是交叉过渡。
#
#   补间由 TweenLite 驱动 p，默认缓动 easeOut（quadratic）：
#     easeOut(t) = -1 * t * (t - 2) = 2t - t²
#     → 前 25% 时间走完 44% 行程（「嗖地旋进来、慢慢停稳」）
#
# 本实现的关键：
#   1) 把 p 做成可补间的代理属性，在 set 里一次算出 4 个值
#   2) 缓动必须加在「进度」上，而不是加在 rotation 上 —— 否则方向会反
#   3) 旧眼全程保持 visible（靠 alpha 淡出），不能 hide
#   4) 每次动画开始时把新眼提到旧眼上方（对应原版 addChildAt + swapChildren）
# ============================================================

# ── 红眼（写轮眼）放大速度倍率（第三十一版：与轮回眼解绑）──────────
# ★ **只作用于「红眼放大」这一段**（写轮眼变大）。
#   ❌ 不影响轮回眼（白盘）变大 —— 那个时长是固定值，见下面的 `白盘时长`。
#   ❌ 不影响普通阶段互切（RotateFade 的 `时长`）—— 那个保持 Flash 原版 2.0s。
#
#   1.00 = 原速（与参考录影一致）    0.26 = 快 74%（当前值）    更小 = 更快
#
# ★★ 提速历程（全程都只调红眼这一段）：1.00 → 0.85 → 0.75 → 0.65 → 0.55 → 0.40 → 0.36 → 0.26
#    用户连续反馈「写轮眼放大还是慢」。**如果还嫌慢，别再加码这个倍率** ——
#    真正的杠杆是缓动：红眼用的是 `TRANS_QUAD + EASE_IN`（**前 1/3 时间几乎不动**，
#    那是参考录影的「蓄力」特征）。把 EASE_IN 换成 EASE_OUT、或换成 `TRANS_SINE`，
#    观感立刻「起手就窜」，而且不影响总时长 —— 这才是「看着更快」的关键。
#    代价：会丢掉「先缓后爆」那层节奏（参考录影里有）。
const 红眼放大速度倍率 := 0.26

const 总旋转 := 720.0      # 原版 numCycle=2 → 2×360
# ★ 普通阶段互切（写轮眼之间的旋转淡出）—— 保持 Flash 原版的 2000ms，
#   不随「红眼放大速度倍率」变化。
const 时长 := 2.0

# 场景里实际存在的容器名
# 注意：原稿写的「数值面板区」在场景里不存在，实际叫「阶段，数值名称切换区」
@onready var 立绘组: Control = find_child("写轮眼阶段立绘", true, false)
@onready var 阶段列表: Control = find_child("阶段列表", true, false)
@onready var 数值面板区: Control = find_child("阶段，数值名称切换区", true, false)
# 左侧按钮滚动区。只用来定位泛光层的插入位置（泛光要盖住眼睛但不压住 UI）
@onready var 滚动按钮列表: Control = find_child("滚动按钮列表", true, false)

# ── 轮回眼专用资源（单独做的一整套，不参与 12 阶段循环）────────────────
# 场景结构（写轮眼内容 之下的顶层兄弟节点）。
#
# ★ 场景文件里的原始顺序是「底图 → 轮回眼 → 轮回眼背景 → 写轮眼背景」，
#   本脚本在 _ready() 里把 写轮眼背景 往下压一位（_把立绘组压到轮回眼之下()），
#   运行时实际绘制顺序（后者在上）：
#   写轮眼内容
#   ├─ 写轮眼背景底图   [Panel]        托底，两张背景共用，不切换
#   ├─ 写轮眼背景       [TextureRect]  337×202，11 只瞳孔立绘挂在它下面（旧眼所在层）
#   ├─ 轮回眼           [TextureRect]  194×194，只在轮回眼阶段显示
#   ├─ 轮回眼背景       [TextureRect]  337×202，带睑裂开孔 → 裁掉轮回眼溢出部分
#   └─ 滚动按钮列表 / 属性面板 / …
#
# ★ 两条关键层级关系（第十九版复查确认，别再退回旧顺序）：
#   · 轮回眼在「轮回眼背景」**之下** —— 194px 大圆盘被睑裂开孔（167×106）一盖，
#     只有开口那部分露出来，视觉上就是「轮回眼嵌在眼眶里」。
#     所以 轮回眼背景 既是背景、也是裁切窗，一举两得。
#     ★ 第十八版曾反过来把 轮回眼背景 压到 轮回眼 之下（理由是「保住完整正圆、
#       不受裁切」）。实测后果：圆盘溢出到眉毛 / 额头 / 脸颊上，而且它最外圈是
#       近黑色（r≥88 处 RGB≈20,14,38），压在眉毛黑线和眼窝暗部上边界直接糊掉 →
#       用户 2026-09-24 反馈「为什么紫色的轮回眼不是圆形 / 为什么没被眼眶盖住」。
#       第十九版已删除那一步，恢复成场景文件本来就写好的顺序。
#   · 轮回眼同时在「写轮眼背景」**之上** —— 圆盘不透明，从中心长出来时
#     天然把旧红眼从内向外盖掉，不再需要反向挖空壳。
#     旧顺序里 写轮眼背景 排在最上层，它的 93px 圆孔会把白盘卡住，
#     收尾时再跳到 166px 睑裂 —— 那就是参考录屏里没有的「末帧爆开」。
#
# ★ 两张背景图外框 100% 一致（实测仅 11.6% 像素不同，且差异全在眼球开孔区），
#   所以切换时观感上「看不出背景换了」，只有眼睛在变。
@onready var 写轮眼背景: TextureRect = find_child("写轮眼背景", true, false)
@onready var 轮回眼背景: TextureRect = find_child("轮回眼背景", true, false)
# ⚠️ 这里原来写的是 `find_child("轮回眼", true, false)` —— 而**本页有两枚同名节点**：
#    根下的这张立绘（TextureRect）与 `滚动按钮列表/阶段列表/轮回眼`（那枚**阶段按钮**）。
#    `find_child` 取的是**树序第一枚**，现在恰好是立绘（它声明在前）⇒ 能跑；
#    但谁把场景里那两个块的先后调一下，这里就会静默变成**按钮**（`as TextureRect` 变 null、
#    立绘整段失效）。改成**写死路径**，与树序无关（2026-10-11 §3.114）。
@onready var 轮回眼立绘: TextureRect = $轮回眼

# ── 底部分页控件（上一页 / 1/12 / 下一页）──────────────────────────
# 场景里这三个节点早就摆好了，但一直是死的：点了没反应、页码也不动。
# 这里把它们接到 _切换阶段() 上，让它们和左栏按钮是**同一套状态**：
#   点 上一页  = 点 前一个阶段按钮
#   点 下一页  = 点 后一个阶段按钮
#   页码文字   = 当前阶段 / 总阶段数，自动跟着变
@onready var 上一页按钮: BaseButton = find_child("上一页", true, false)
@onready var 下一页按钮: BaseButton = find_child("下一页", true, false)
@onready var 页码标签: Label = find_child("页码", true, false)

# 走到两端时的处理：
#   true  = 循环（1 → 12 → 1 → 12 …），单机刷起来方便
#   false = 到头就停，按钮同时变灰不可点（更像原版客户端）
const 页码循环 := false

# 「轮回眼」阶段的按钮名 / 属性面板组名 —— 整个脚本靠**名字**识别它，
# 不再依赖任何位置索引（用户随时可能增删节点，索引必坏）。
const 轮回眼名称 := "轮回眼"
const 轮回眼面板名 := "轮回眼阶段"

# 面板组名与按钮名不一致时的别名表：「面板组基名 → 对应的按钮名」。
# 场景里「轮回血轮眼阶段」是历史笔误（按钮叫「轮回写轮眼」），
# 这里兜住它，避免为了一个错字去改场景文件、影响打包。
const 别名字段 := {
	"轮回血轮眼": "轮回写轮眼",
}

# 轮回眼自身圆盘的内容中心（图内坐标，实测 alpha 包围盒 = (0,1)-(193,193)）
const 轮回眼内容中心 := Vector2(97.0, 97.0)

# 背景图上睑裂开孔的圆心（轮回眼背景.png 实测：透明区 bbox (72,45)-(238,149)，
# 但**质心**在 (149.5, 99.6) —— 睑裂左右不对称，取 bbox 中心会偏右 4.5px）。
# 这里取写轮眼圆孔的中心 (150.5, 97.5)：它与睑裂质心只差 1.0 / 2.1px，
# 同时让轮回眼圆心与 12 只瞳孔的圆心**完全重合**——
# 白盘扩张才是「同心」地把红眼从中心啃掉，而不是偏心啃。
const 轮回眼睑裂中心 := Vector2(150.5, 97.5)

var _瞳孔列表: Array[TextureRect] = []
var _按钮列表: Array[BaseButton] = []
var _面板组列表: Array[Control] = []

# 「轮回眼」在 _瞳孔列表 中的位置（-1 = 未找到）
# 不写死：每次 _ready() 按名字算出来，用户增删节点都不会错。
var _轮回眼索引: int = -1

# ── 旋转轴心校正表 ───────────────────────────────────────────────
# 背景图上那个「洞」的圆心（父坐标系），由 写轮眼背景.png 实测得出：
#   bbox = (105,52)-(196,143)  →  直径 92×92，圆心 (150.5, 97.5)
const 洞心 := Vector2(150.5, 97.5)

# 瞳孔在屏幕上的显示尺寸（正方形边长）。
# 与贴图分辨率**解耦**：素材从 94×94 换成 256×256 高清版时这个值保持不变，
# 由 TextureRect 的 STRETCH_SCALE 把高分辨率贴图缩放进 94 的框里 ——
# 结果就是「静止时大小完全不变、放大时更清晰」。
# 若不与分辨率解耦，换成 256 的素材会让眼睛直接变成 2.7 倍大。
# ★ 12 张瞳孔都实测过：内容是一枚「内切圆刚好撑满画布」的圆，
#   所以内容中心恒等于 显示尺寸 / 2，不需要逐张例外表。
const 瞳孔显示尺寸 := 94.0

# 设为 true 时，_ready() 会把每个瞳孔的 pivot 强制校正为「圆心=图形内容中心」。
# 这样旋转就绕图自己的中心走，不会画圈（即「升起落下」）。
# 若你日后在编辑器里手工调好了位置，把这个开关关掉即可保留手工值。
const 自动校正轴心 := true

# ⚠️ 已撤回的实验（第二十五版，别再原样加回来）：
#   为了治「红眼放大时抖动」，曾把 94px 的瞳孔贴图用 Lanczos 上采样 4× 再当贴图用。
#   **失败**：节点是 LINEAR 且不带 mipmap，静止时 94px 的显示尺寸对 376px 的贴图
#   = **4:1 缩小**，GPU 的 2×2 双线性采样滤不掉 → 勾玉细线直接走样，
#   用户反馈「写轮眼弄坏了」。
#   ✅ 正确做法是 **2×（188）**：静止时正好 2:1 缩小（双线性刚好覆盖 2×2 → 干净），
#   而放大时又不存在「放大」了。详见交接文档「已知问题 1」。

# ============================================================
# 轮回眼专属特效的开关与状态位
# 详细机制说明见 _播放轮回眼生长特效() 上方的注释块。
#
# ★ 用户明确要求「只进不出」：只有「非轮回眼 → 轮回眼」播放这套特效，
#   反方向离开时走普通旋转淡出，避免离开也吵。
# ============================================================

var _轮回眼特效中 := false

# 显式状态，不从节点 visible 反推（原稿最脆弱的地方）
var _当前阶段: int = -1

# 旋转动画的角色
var _旧瞳孔: TextureRect
var _新瞳孔: TextureRect
var _tween: Tween

# 代理属性：0 → 1，由 Tween 补间；set 里统一驱动 4 个真实属性
var _进度: float = 0.0:
	set(值):
		_进度 = 值
		_应用到瞳孔()


func _ready() -> void:
	# ---------- 1. 收集按钮（这是「阶段」的权威顺序）----------
	# 场景里 立绘组 比按钮少一个节点（旧的「轮回眼」立绘已被删除），
	# 所以阶段序号一律以**按钮列表**为准，立绘按名字去配。
	if 阶段列表 != null:
		for 节点 in 阶段列表.get_children():
			if 节点 is BaseButton:
				_按钮列表.append(节点)
			else:
				push_warning("阶段列表里混入了非按钮节点：%s" % 节点.name)

	# ---------- 2. 收集瞳孔：按名字与按钮一一配对 ----------
	# ★ 这是本脚本最关键的映射逻辑，绝不能再用固定索引。
	#   历史坑：曾经用 const 轮回眼序号 := 8 去替换 _瞳孔列表[8]，
	#   用户删掉旧「轮回眼」立绘后索引 8 变成了「六勾玉轮回眼」，
	#   结果六勾玉轮回眼被误隐藏、还被新轮回眼节点顶替 —— 永远显示不出来。
	#   改为按名字查找后，增删任何节点都不会再错位。
	_瞳孔列表.resize(_按钮列表.size())          # 先按阶段数占满，空位留 null
	_轮回眼索引 = -1
	if 立绘组 != null:
		for 节点 in 立绘组.get_children():
			if not (节点 is TextureRect):
				continue
			(节点 as TextureRect).z_index = 0
			# 用节点名去按钮列表里找它属于哪个阶段
			var 位置 := _按名字找按钮(节点.name)
			if 位置 < 0:
				push_warning("立绘「%s」在按钮列表里找不到同名的阶段，已忽略" % 节点.name)
				continue
			_瞳孔列表[位置] = 节点

	# ---------- 3. 把「轮回眼」那一格换成独立节点 ----------
	# 旧的 12 张瞳孔图里那个「轮回眼」已被用户删除，现在这一格必须由
	# 顶层节点「轮回眼」顶上，否则点轮回眼按钮时眼睛不动。
	_轮回眼索引 = _按名字找按钮(轮回眼名称)
	if 轮回眼立绘 != null and _轮回眼索引 >= 0:
		_瞳孔列表[_轮回眼索引] = 轮回眼立绘
	else:
		push_warning("没找到「%s」按钮或「%s」立绘节点，轮回眼阶段将无立绘" % [轮回眼名称, 轮回眼名称])

	# ---------- 4. 收集右侧数值面板的阶段组（按名字对齐，不靠下标）----------
	# 场景里每组叫「单勾玉阶段」「双勾玉阶段」…「轮回血轮眼阶段」「净眼阶段」，
	# 即「按钮名 + 阶段」。用名字配对，避免子节点数量变化把映射冲垮。
	_面板组列表.resize(_按钮列表.size())
	if 数值面板区 != null:
		for 节点 in 数值面板区.get_children():
			if not (节点 is Control):
				continue
			if not 节点.name.ends_with("阶段"):
				continue
			var 基名 := String(节点.name).trim_suffix("阶段")
			var 位置 := _按名字找按钮(基名)
			# 场景里有个历史笔误：按钮叫「轮回写轮眼」，面板组却叫「轮回血轮眼阶段」。
			# 用别名表兜住，避免为一个错字去改场景（改了反而破坏打包一致性）。
			if 位置 < 0:
				位置 = _按名字找按钮(别名字段.get(基名, ""))
			if 位置 < 0:
				push_warning("面板组「%s」在按钮列表里找不到对应阶段，已忽略" % 节点.name)
				continue
			_面板组列表[位置] = 节点
	for i in _面板组列表.size():
		if _面板组列表[i] == null:
			push_warning("阶段 %d「%s」缺少对应的数值面板组" % [i, _按钮列表[i].name])

	# ---------- 5. 按钮接线 + 补齐 toggle_mode ----------
	for i in _按钮列表.size():
		_按钮列表[i].pressed.connect(_on_按钮被点击.bind(i))
		# 按钮的样式/文字都在场景里配好了（StyleButton / StyleButtonDown / 字色 …），
		# 唯一缺的是 toggle_mode —— 打开它按钮才会记住「按下」状态、
		# 才会去用 pressed 那张贴图和 font_pressed_color。
		# 这里补齐即可，不覆盖任何已有外观设置。
		_按钮列表[i].toggle_mode = true

	# ---------- 6. 底部分页控件接线 ----------
	# 上一页 / 下一页 是 TextureButton，没有 toggle_mode 的语义，
	# 直接接 pressed 即可；页码只是 Label，由 _刷新页码() 更新。
	if 上一页按钮 != null:
		上一页按钮.pressed.connect(_on_上一页)
	else:
		push_warning("场景里没找到「上一页」节点，底部左箭头将不可用")
	if 下一页按钮 != null:
		下一页按钮.pressed.connect(_on_下一页)
	else:
		push_warning("场景里没找到「下一页」节点，底部右箭头将不可用")
	if 页码标签 == null:
		push_warning("场景里没找到「页码」节点，页码将不会更新")

	# ---------- 7. 层级重排 ----------
	# 把「写轮眼背景」（连它下面的 11 只瞳孔）压到「轮回眼」之下，
	# 这样白盘才能盖住旧眼、且从一开始就受睑裂裁切。详见函数注释。
	_把立绘组压到轮回眼之下()

	if 自动校正轴心:
		_校正全部轴心()
		_校正轮回眼轴心()          # 轮回眼另有睑裂对齐规则，单独校正

	# ⚠️ 第二十五版曾在这里做「瞳孔贴图超采样」（Lanczos 上采样 4×）来治红眼放大抖动，
	#    结果把静止画面弄花了 —— 原因：节点是 LINEAR 且不带 mipmap，
	#    94px 的显示尺寸配 376px 的贴图 = **4:1 缩小**，GPU 的 2×2 双线性根本滤不掉
	#    → 勾玉细线直接走样。**已撤回，别再原样加回来。**
	#    要做就做 **2×（188）**：静止时正好 2:1 缩小（双线性刚好覆盖 2×2，干净），
	#    放大时又不存在「放大」了。详见交接文档「已知问题 1」。

	# ---------- 9. 提升阶数弹窗接线（第二十八版）----------
	# 按钮「提升写轮眼阶数」→ 弹窗滑入；「滑出」播完自动隐藏。详见函数上方说明。
	_接线提升阶数弹窗()

	_应用背景(-1, false)            # 初始化背景（进入轮回眼前的状态）
	_切换阶段(0)


# 在按钮列表里按名字查阶段序号（0 起算），找不到返回 -1。
# Godot 节点名可能与按钮名不完全一致，所以额外做一次「去掉『阶段』后缀」的兼容。
func _按名字找按钮(名字: String) -> int:
	for i in _按钮列表.size():
		if _按钮列表[i].name == 名字:
			return i
	return -1


# ============================================================
# 底部分页控件（上一页 / 1/12 / 下一页）
# ------------------------------------------------------------
# 这三个控件复用 _切换阶段()，因此和左栏按钮共享同一份状态：
#   · 页码永远是「当前阶段序号 + 1 / 总数」
#   · 无论你是点左栏按钮、还是点翻页箭头，页码都会同步刷新
#   · 点右箭头 = 点下一个阶段的按钮，写轮眼切换动画照常播放
# ============================================================

func _on_上一页() -> void:
	var 总数 := _按钮列表.size()
	if 总数 <= 0:
		return
	var 目标 := _当前阶段 - 1
	if 目标 < 0:
		if not 页码循环:
			return                   # 已在首页：按钮本身已是 disabled，这里只做兜底
		目标 = 总数 - 1          # 循环模式：1 → 12
	_切换阶段(目标)


func _on_下一页() -> void:
	var 总数 := _按钮列表.size()
	if 总数 <= 0:
		return
	var 目标 := _当前阶段 + 1
	if 目标 >= 总数:
		if not 页码循环:
			return                   # 已在末页：按钮本身已是 disabled
		目标 = 0                     # 循环模式：12 → 1
	_切换阶段(目标)


# 刷新页码文字 + 两侧箭头的可用状态。
#
# ★ 箭头的灰化 / 手型光标 / 点击拦截全部交给节点上挂的「箭头按钮交互.gd」，
#   这里只负责告诉它「现在能不能点」。
#   和柔拳页的做法完全一致 —— 两个页面的切页手感因此统一。
func _刷新页码() -> void:
	if 页码标签 == null or _按钮列表.size() == 0:
		return
	var 总数 := _按钮列表.size()
	var 当前 := clampi(_当前阶段 + 1, 0, 总数)
	页码标签.text = "%d/%d" % [当前, 总数]

	if not 页码循环:
		设置箭头可用(上一页按钮, _当前阶段 > 0)
		设置箭头可用(下一页按钮, _当前阶段 < 总数 - 1)


# 调用箭头节点上的 设置是否可用()。用 has_method 兜底：
# 万一某天箭头节点的脚本被摘掉，这里也不会报错，只是失去灰化效果。
func 设置箭头可用(箭头: BaseButton, 可用: bool) -> void:
	if 箭头 == null or not is_instance_valid(箭头):
		return
	if 箭头.has_method("设置是否可用"):
		箭头.call("设置是否可用", 可用)
	else:
		箭头.disabled = not 可用


# ============================================================
# 提升写轮眼阶数弹窗（第二十八版接线）
# ------------------------------------------------------------
# 场景里「提升写轮眼阶数弹窗」已经建好了：
#   · Control + clip_contents，静止位置 (5, 228)，**默认 visible = false**
#   · 子节点「滑出动画」[AnimationPlayer]，带 滑入 / 滑出 两条 0.5s 动画（改 .:position）
#   · 它挂的脚本是「柔拳/脚本/提升柔拳阶数弹窗滑动动画.gd」→ 有 open_popup() / _on_close_button_pressed()
#   · .tscn 里「关闭按钮」已连到 _on_close_button_pressed ✓
#   ❌ 唯一缺的：「提升写轮眼阶数」按钮 → open_popup 这条线。
#
# ★ 为什么用脚本接线而不是改 .tscn：
#   .tscn 有 17 万字节，而且用户常开着编辑器 —— 编辑器会静默回写场景文件，
#   手改磁盘上的 .tscn 有被覆盖/冲突的风险。运行时 connect 完全等价且零风险。
#
# ★ 与柔拳页的唯一差别：柔拳的弹窗**默认是显示的**，写轮眼这个是 `visible = false`。
#   所以这里补两件事：
#     ① 打开前先 `visible = true`（否则动画在跑但根本看不见）
#     ② 「滑出」播完再 `visible = false`（否则它会停在 y=700 被画到面板外面）
# ============================================================

const 弹窗名 := "提升写轮眼阶数弹窗"
const 弹窗按钮名 := "提升写轮眼阶数"
const 弹窗动画节点名 := "滑出动画"

var _提升弹窗: Control


func _接线提升阶数弹窗() -> void:
	var 弹窗 := find_child(弹窗名, true, false)
	var 按钮 := find_child(弹窗按钮名, true, false)
	if 弹窗 == null:
		push_warning("场景里没找到「%s」，提升阶数弹窗将不可用" % 弹窗名)
		return
	if 按钮 == null:
		push_warning("场景里没找到「%s」按钮，弹窗无法打开" % 弹窗按钮名)
		return
	_提升弹窗 = 弹窗
	# ★ 场景的 [connection] 里已经把「提升写轮眼阶数」连到弹窗的 open_popup()（与柔拳页一致）。
	#   这里只做**兜底**：仅当场景里没有那条连接、且本脚本也没接过时才接 ——
	#   否则一次点击会触发两次 open_popup，滑入动画会被重启。
	var 场景已接线 := false
	for 连接 in 按钮.pressed.get_connections():
		if 连接.get("callable", Callable()).get_object() == 弹窗:
			场景已接线 = true
			break
	if 场景已接线:
		pass                                   # 用场景自带的连线（推荐路径）
	elif not 按钮.pressed.is_connected(_打开提升弹窗):
		按钮.pressed.connect(_打开提升弹窗)    # 兜底
	var 动画 := 弹窗.get_node_or_null(弹窗动画节点名)
	if 动画 is AnimationPlayer and not 动画.animation_finished.is_connected(_提升弹窗动画结束):
		动画.animation_finished.connect(_提升弹窗动画结束)


func _打开提升弹窗() -> void:
	if _提升弹窗 == null:
		return
	# 场景里默认是隐藏的；必须先亮起来，动画才看得见
	_提升弹窗.visible = true
	# 复用柔拳那套滑动脚本（播放「滑入」= 从下方滑上来）
	if _提升弹窗.has_method("open_popup"):
		_提升弹窗.call("open_popup")
	else:
		var 动画 := _提升弹窗.get_node_or_null(弹窗动画节点名)
		if 动画 is AnimationPlayer:
			动画.play("滑入")


func _提升弹窗动画结束(名称: StringName) -> void:
	# 「滑出」跳完再真正隐藏 —— 否则弹窗会停在动画终点（y=700）被画到面板外面
	if String(名称) == "滑出" and _提升弹窗 != null:
		_提升弹窗.visible = false


func _校正全部轴心() -> void:
	# 旋转时，图形绕着「pivot_offset 对应的那个点」转。
	# pivot_offset 是节点局部坐标，父坐标系里那个点是 (offset_left + pivot.x, offset_top + pivot.y)。
	# 只有当这个点 = 图形内容在父坐标系里的中心时，旋转才是「原地打转」；
	# 否则图形会绕一个偏心点公转一圈 —— 这就是你看到的「升起 / 落下」。
	#
	# 做法：把 pivot 设成内容中心，再把节点整体平移，
	# 使「内容的父坐标系中心」正好落在背景洞里。
	for i in _瞳孔列表.size():
		var 瞳孔 := _瞳孔列表[i]
		if not is_instance_valid(瞳孔):
			continue
		# ★ 轮回眼不走这里：它有自己的一套背景和睑裂对齐规则，
		#   交给 _校正轮回眼轴心() 单独处理，避免被这里的「洞心」逻辑带偏。
		#   判断方式用「节点身份」而非索引 —— 索引在增删节点后不可靠。
		if 瞳孔 == 轮回眼立绘:
			continue
		var 图 := 瞳孔.texture
		if 图 == null:
			continue

		# ★ 节点框固定为「瞳孔显示尺寸」，**不跟随贴图分辨率**（见常量处说明）。
		#   pivot 落在框的正中 = 贴图内容中心，旋转与缩放才都绕圆心。
		var 显示 := Vector2(瞳孔显示尺寸, 瞳孔显示尺寸)
		瞳孔.stretch_mode = TextureRect.STRETCH_SCALE

		var 框 := Vector2(瞳孔.offset_right - 瞳孔.offset_left,
				瞳孔.offset_bottom - 瞳孔.offset_top)
		if not 框.is_equal_approx(显示):
			push_warning("「%s」节点框 %s 与显示尺寸 %s 不一致，已强制对齐" % [瞳孔.name, 框, 显示])

		瞳孔.pivot_offset = 显示 * 0.5
		瞳孔.offset_left = 洞心.x - 显示.x * 0.5
		瞳孔.offset_top = 洞心.y - 显示.y * 0.5
		瞳孔.offset_right = 瞳孔.offset_left + 显示.x
		瞳孔.offset_bottom = 瞳孔.offset_top + 显示.y
		瞳孔.rotation_degrees = 0.0


func _校正轮回眼轴心() -> void:
	# 无缝旋转的唯一要求，和其余 11 只眼完全一样：
	#   「pivot_offset 对应的点」必须等于「图形内容的中心」。
	# 轮回眼1.png 的圆盘中心实测在 (97, 97)，贴图 194×194，所以 pivot = (97,97) 天然成立。
	# 剩下就是把节点摆到「圆心正好落在睑裂中心」的位置。
	if 轮回眼立绘 == null or 轮回眼背景 == null:
		return
	var 图 := 轮回眼立绘.texture
	if 图 == null:
		return

	var 图尺寸 := 图.get_size()

	# 节点框必须 == 贴图尺寸：一旦被拉伸/居中，pivot 与内容就会错开（抖动之源）
	var 框 := Vector2(轮回眼立绘.offset_right - 轮回眼立绘.offset_left,
			轮回眼立绘.offset_bottom - 轮回眼立绘.offset_top)
	if not 框.is_equal_approx(图尺寸):
		push_warning("轮回眼 节点框 %s 与贴图尺寸 %s 不一致，已强制对齐" % [框, 图尺寸])
		轮回眼立绘.stretch_mode = TextureRect.STRETCH_SCALE
		轮回眼立绘.offset_right = 轮回眼立绘.offset_left + 图尺寸.x
		轮回眼立绘.offset_bottom = 轮回眼立绘.offset_top + 图尺寸.y

	# 内容中心越界保护（正常不会发生）
	var 中心 := 轮回眼内容中心
	if 中心.x < 0.0 or 中心.y < 0.0 or 中心.x > 图尺寸.x or 中心.y > 图尺寸.y:
		中心 = 图尺寸 * 0.5

	轮回眼立绘.pivot_offset = 中心

	# 把圆心钉到睑裂中心。
	# 坐标换算：睑裂中心是「轮回眼背景」图内坐标，
	# 先换算到父节点（写轮眼内容）坐标系，再反推轮回眼节点的 offset。
	# 用 offset_left/top（原始布局数据）而不是 position，
	# 因为 position 是 anchor+offset 派生出来的，节点还没进树时不一定可靠。
	var 睑裂在父系 := Vector2(轮回眼背景.offset_left, 轮回眼背景.offset_top) + 轮回眼睑裂中心
	轮回眼立绘.offset_left = 睑裂在父系.x - 中心.x
	轮回眼立绘.offset_top = 睑裂在父系.y - 中心.y
	轮回眼立绘.offset_right = 轮回眼立绘.offset_left + 图尺寸.x
	轮回眼立绘.offset_bottom = 轮回眼立绘.offset_top + 图尺寸.y
	轮回眼立绘.rotation_degrees = 0.0


# 重排层级，让绘制顺序变成：
#     底图 → 写轮眼背景(含 11 只瞳孔/旧眼) → 轮回眼 → 轮回眼背景 → UI
#
# ★ 这个顺序 **就是 写轮眼页.tscn 里本来就写好的顺序**。
#   本函数只需要把 写轮眼背景 从最上层往下压到第 1 位（紧跟底图）；
#   轮回眼 与 轮回眼背景 的相对位置保持场景原样（轮回眼在下、背景在上）。
#
# ★ 为什么必须让 轮回眼背景 盖在 轮回眼 之上（第十九版确定）：
#   它是「带眼眶开孔的脸」。盖在圆盘之上时，它的开孔就是**裁切窗** ——
#   194px 的正圆盘被开孔一裁，只露出眼眶那一块，这就是要的「嵌在眼眶里」效果。
#   对照用户给的 PS 合成：脸层必须压在眼球层**上面**，紫色才会只从眼眶洞里露出来。
#   ❌ 第十八版曾反过来把 轮回眼背景 压到 轮回眼 之下，理由是「保住完整正圆、不受裁」。
#      实测后果：圆盘不再受任何裁切 → 溢出到眉毛 / 额头 / 脸颊；且它最外圈是近黑色
#      （r≥88 处 RGB≈20,14,38），压在眉毛黑线与眼窝暗部上边界直接糊掉 →
#      用户 2026-09-24 反馈「为什么紫色的轮回眼不是圆形 / 为什么没被眼眶盖住」。
#      ⚠️ 所以「把 轮回眼背景 移到 轮回眼 之下」的 move_child 不能再加回来。
#
# ★ 旧红眼照样能被裁干净（不依赖第十八版的翻转）：
#   11 只瞳孔是 写轮眼背景 的子节点，而 写轮眼背景 现在排在第 1 位（最靠下），
#   所以旧红眼放大后的溢出同样被 轮回眼背景 的开孔挡住 ✅
#   界面控件排在更后面，依旧压在两者之上 ✅
#
# ★ 为什么必须这样（第四版的核心改动）：
#   旧顺序里 写轮眼背景 排在最后（最上层），而它的眼球开孔只有 93px。
#   于是白盘扩张时被这个 93px 圆孔卡住，红眼永远盖不干净；
#   收尾时 轮回眼背景 的 166px 睑裂一亮，可视区从 93px 圆**瞬间跳到** 166px 椭圆 ——
#   参考录屏里没有这个突跳（实测睑裂宽度全程恒定）。
#   调整之后：
#     · 白盘（不透明）在旧眼之上 → 从中心长出来天然把红眼从内向外盖掉，
#       原来的「反向圆挖空壳」因此整体删除
#     · 睑裂(166×104) 从动画第一帧就作为裁切窗生效 → 不再有末帧突跳
#
# ★ 为什么在代码里移位、而不是直接改 .tscn：
#   这个场景 17 万字节、节点上百个，手改节点声明顺序极易把子节点的
#   parent="写轮眼背景/写轮眼阶段立绘" 这类路径搞乱，风险远大于收益。
#   运行时 move_child 与改文件完全等价，且零风险。
#   若你希望它成为场景里的固定顺序：在编辑器里把「写轮眼背景」
#   往上拖到「轮回眼」之前即可（拖一次就永久生效，本函数会自动跳过）。
func _把立绘组压到轮回眼之下() -> void:
	if 写轮眼背景 == null or 轮回眼立绘 == null:
		return
	var 父 := 写轮眼背景.get_parent()
	if 父 == null or 父 != 轮回眼立绘.get_parent():
		return
	# 把 写轮眼背景（含 11 只瞳孔 / 旧红眼）压到底图之上、其余节点之下。
	# ★ 只做这一件事：不再动 轮回眼背景 的位置，让它留在 轮回眼 之上当裁切窗。
	if 写轮眼背景.get_index() > 1:
		父.move_child(写轮眼背景, 1)


func _应用背景(阶段索引: int, 动画中: bool) -> void:
	# 两张背景图外框完全一致，差异仅在眼球开孔区（实测 11.6% 像素），
	# 所以切换时观感上「看不出背景换了」，只有眼睛在变。
	#
	# ★ 层级要点：轮回眼背景 同时承担「背景」和「遮罩」两个职责。
	#   它在树里排在 轮回眼 之后 → 绘制时盖在轮回眼之上 →
	#   194px 的大圆盘被它的睑裂开孔裁掉溢出部分，只露出眼眶大小的圆形。
	#
	# ★★ 致命陷阱（必须按下面的方式处理，否则眼睛会「啪」地消失）：
	#   11 只普通瞳孔挂在「写轮眼阶段立绘」下，而立绘组是「写轮眼背景」的子节点！
	#   只要把 写轮眼背景 一隐藏，整组立绘（连同正在被挤开的旧眼）会瞬间不见，
	#   看起来就是「点了轮回眼 → 一片漆黑、眼睛没了」。
	#   所以：进入轮回眼时**不能立刻隐藏 写轮眼背景**，
	#   要等白盘扩张把红眼完全盖住之后（_轮回眼特效结束() 里再关）。
	#
	#   反过来，离开轮回眼时可以立刻切换 —— 立绘组本来就是新图，不需要过渡。
	var 用轮回眼 := (阶段索引 == _轮回眼索引)

	if 用轮回眼:
		# 进入方向：先亮起「轮回眼背景」（它负责裁掉圆盘溢出部分），
		# 写轮眼背景 保持可见，让红眼还在原位、等着被白盘盖掉。
		if 轮回眼背景 != null:
			轮回眼背景.visible = true
		# 写轮眼背景 的显隐交给 _轮回眼特效结束() 处理
	else:
		# 离开方向：立刻切回普通背景（立绘组跟着回来）
		if 写轮眼背景 != null:
			写轮眼背景.visible = true
		if 轮回眼背景 != null:
			轮回眼背景.visible = false
		# 轮回眼本体也收起来，避免它在下一阶段残留；
		# 遮罩同时复位到「未扩张」，下次进入时才会重新从中心长出来。
		if 轮回眼立绘 != null:
			轮回眼立绘.visible = false
		_扩张进度 = 0.0
		_应用扩张()


func _切换阶段(索引: int) -> void:
	if 索引 < 0 or 索引 >= _瞳孔列表.size():
		return

	# 原版重复点当前阶段会空转一圈（旧眼=新眼，视觉几乎无变化）。
	# 这里直接忽略；但要顺手把按钮状态纠回来 ——
	# 按钮是 toggle_mode，重复点击会把自己「弹出」，看起来像没选中。
	if 索引 == _当前阶段:
		_同步按钮状态(索引)
		_刷新页码()                  # 页码也纠一次，防止外部改动导致不同步
		return

	var 旧索引 := _当前阶段
	_当前阶段 = 索引

	# ---------- 0. 页码 ----------
	# 放在最前面：页码只是文字，没有副作用，先改完再跑动画，
	# 这样翻页时数字和眼睛是「同时」变的，不会有 0.5 秒的迟滞感。
	_刷新页码()

	# ---------- 1. 背景：进出轮回眼时切换 ----------
	# 放在旋转动画之前 —— 眼睛的淡入淡出会盖住这一瞬的变化
	_应用背景(索引, true)

	# ---------- 2. 立绘旋转（异步，不 await） ----------
	# 原版 setTab 里五项是同步切换的，动画另起一路跑，
	# 不能阻塞按钮高亮和右侧面板的更新。
	_播放旋转动画(旧索引, 索引)

	# ---------- 3. 按钮高亮 ----------
	# 按钮自己就带完整的状态样式（场景里配置的）：
	#   toggle_mode = true            → 按钮能记住「按下」状态
	#   button_pressed = true         → 初始选中态
	#   theme_override_styles/normal  = StyleButton     （未选中贴图）
	#   theme_override_styles/pressed  = StyleButtonDown （选中贴图）
	#   theme_override_styles/hover   = StyleButton     （悬停贴图）
	#   theme_override_colors/font_pressed_color       （选中字色）
	#
	# ★ 所以脚本不该再往按钮上叠 modulate ——
	#   modulate 是乘法，会把按钮自带的贴图整体压暗，
	#   结果就是「按钮不是我本来的样子」。
	#   这里只驱动 button_pressed，其余全部交给 Godot 原生样式系统。
	_同步按钮状态(索引)

	# ---------- 4. 右侧数值面板显隐 ----------
	# 面板组与阶段一一对应（按名字配对，见 _ready() 第 4 步）
	for i in _面板组列表.size():
		var 组 := _面板组列表[i]
		if is_instance_valid(组):
			组.visible = (i == 索引)


# 键盘 ← / → 翻页。
# 注意：用 _unhandled_input 而不是 _input，
# 这样按钮/输入框等已消费的事件不会被我们抢走。
#
# ★★ 第三十版删掉了这里的「鼠标滚轮翻页」（原来滚轮也能翻页），原因是它和
#    左侧阶段列表（ScrollContainer）打架：
#      · 列表还能滚时，滚轮被 ScrollContainer 消费掉，一切正常；
#      · **一旦滚到列表两端**，ScrollContainer 就不再消费滚轮事件 →
#        事件漏成 unhandled → 被这里接住 → 直接调用 _切换阶段()（= 切阶段）。
#    用户看到的现象就是「滚到底以后继续滚，滚轮变成了在按按钮」。
#    ⚠️ 滚轮只应该滚列表，不该切阶段 —— 所以这个分支不能再加回来。
func _unhandled_input(事件: InputEvent) -> void:
	if 事件 is InputEventKey and 事件.pressed and not 事件.echo:
		match (事件 as InputEventKey).keycode:
			KEY_LEFT:
				_on_上一页()
				get_viewport().set_input_as_handled()
			KEY_RIGHT:
				_on_下一页()
				get_viewport().set_input_as_handled()


func _播放旋转动画(旧索引: int, 新索引: int) -> void:
	# 原版 setRotateFade 开头的打断处理：
	#   if (rotateFade && rotateFade.isSwapping) { rotateFade.end(); rotateFade = null; }
	_打断当前动画()

	var 新 := _瞳孔列表[新索引]
	_旧瞳孔 = _瞳孔列表[旧索引] if 旧索引 >= 0 and 旧索引 != 新索引 else null
	_新瞳孔 = 新

	# ---------- 图层顺序 ----------
	# 瞳孔是兄弟节点，绘制顺序 = 在容器里的排列顺序，序号大的默认盖在上面。
	# 切到「序号更小」的阶段时，旧眼会把新眼整个挡住 → 看起来像没反应。
	# 原版 RotateFade.start() 的做法（:53-54）：
	#   _container.addChildAt(_target2, _container.getChildIndex(_target1) + 1);
	#   _container.swapChildren(_target1, _target2);
	# 即「把新眼提到旧眼之上」。
	# 这里用 z_index 实现（只影响绘制顺序，不动树结构，避免下标错位）。
	# ★ 轮回眼不在「写轮眼阶段立绘」里（它是顶层节点，和背景是兄弟关系），
	#   它下面的 z_index 只可能相对立绘组内部，动它反而会盖住自己的遮罩背景。
	#   所以轮回眼永远保持 z_index = 0，层级完全交给树顺序。
	if 新索引 == _轮回眼索引 or 新 == 轮回眼立绘:
		新.z_index = 0
	elif _旧瞳孔 != null and 立绘组 != null:
		var 层 := 0
		for 节点 in 立绘组.get_children():
			if 节点 is TextureRect:
				层 = maxi(层, (节点 as TextureRect).z_index)
		_新瞳孔.z_index = 层 + 1
	else:
		_新瞳孔.z_index = 1

	# ---------- 分流：进入轮回眼 → 播放专属「生长」特效 ----------
	# 用户要求「只进不出」：仅当新阶段是轮回眼、且旧阶段不是轮回眼时走特效。
	if 新索引 == _轮回眼索引 and 新索引 != 旧索引:
		_播放轮回眼生长特效()
		return

	# ---------- 以下为通用旋转淡出（其余 11 只眼睛完全不变）----------
	# 起点状态
	# 顺序很重要：先把起点摆好，再让 _进度 回到 0 触发一次 set，
	# 否则新眼会以「上一轮结束后的完整状态」闪现一帧（你看到的「立马出现」）。
	if _旧瞳孔 != null:
		_旧瞳孔.visible = true          # ★ 必须保持可见：靠 alpha 淡出，不能 hide
		_旧瞳孔.modulate.a = 1.0
		_旧瞳孔.rotation_degrees = 0.0

	_新瞳孔.visible = true
	_新瞳孔.modulate.a = 0.0
	_新瞳孔.rotation_degrees = 总旋转   # 720° 视觉等价 0°，不会闪出歪图

	# 强制写一次起点：即使 _进度 原本就是 0，也确保 4 个属性此刻已经被正确初始化
	_应用到瞳孔()

	# 只补间「_进度」——缓动加在进度上，方向才与原版一致
	_tween = create_tween()
	_tween.set_trans(Tween.TRANS_QUAD)
	_tween.set_ease(Tween.EASE_OUT)
	_tween.tween_property(self, "_进度", 1.0, 时长).from(0.0)
	_tween.finished.connect(_动画结束)


# ============================================================
# 轮回眼专属：「白盘扩张 + 红眼顺时针旋转被啃掉」
# ------------------------------------------------------------
# 素材来源：用户录屏 QQ20260923-211620.gif（656×308 / 38 帧 / 3140ms / ~12fps，双眼同步）。
#
# ★★★ 第四版修正（2026-09-24）：第三版的量化**测错了对象**。
#   当时取的是「最亮区域半径」，实际测到的是**眼白（巩膜）**——巩膜恒定不变，
#   于是错判成「白盘瞬间跳出满孔」，把时长定成 0.12s，还凭臆想加了
#   「旧眼旋转 196°」和 TRANS_BACK 超调。本版改用**红环内缘半径**重测：
#   红眼是被白盘从内向外啃的，内缘才是白盘的真实边界。
#
#   帧   累计ms  中心列浅色段高  中心列红段   事件
#   F00     0        0          86..130     红眼静止
#   F11   870        0          86..130     仍静止
#   F17  1400        0          82..128     红眼极缓慢放大（蓄力）
#   F19  1600        1          74..134     ★ 白盘开始出现
#   F20  1670       11          74..135     白盘 r≈5.5
#   F21  1800       22          70..136     白盘 r≈11
#   F22  1870       34         115..137     白盘 r≈17
#   F23  1930       45         124..132     白盘 r≈22.5
#   F24  2000       56         134..136     白盘 r≈28
#   F25  2070       63            -         红眼基本消失
#   F26  2130       67            -         白盘铺满睑裂高度
#   F27  2200       66            -         稳定
#
# ★★★ 三条修正后的结论：
#
#   1) **白盘扩张历时 0.53s，且近似线性**（中心列每帧稳定 +11px）。
#      F26 之后不再增长**不是缓动收尾，而是被睑裂裁切**——
#      浅色段高 67px 恰好等于当时的眼眶高度。
#
#   2) **旧眼不旋转，是放大。** 红外缘 36.0 → 86.5px ≈ 2.4 倍，
#      且分两段：前 1.0s 极缓（36→40），之后加速。
#      旋转方面用「三勾玉的三次谐波相位」复核：F00→F16 只漂移约 −18°，
#      F19 之后随 tomoe 被啃碎而乱跳 —— 没有可信的旋转证据。
#      旧版「红质心右移 0.8px/帧」是不对称啃食造成的**假位移**。
#
#   3) **不叠加任何紫色泛光**：紫像素在 F28 之后稳定在 3.60%，
#      那是轮回眼素材本身的颜色。泛光层自第一版起就已删除，这一点始终正确。
#
# ★ 四段式时间线（**参考录影的原始时间轴，总 2.2s**）：
#     0.00~0.35s  静止
#     0.35~1.45s  红眼缓慢放大（蓄力）
#     1.45~1.60s  加速放大
#     1.60~2.13s  白盘从中心长出、把红眼吞掉（0.53s，线性）
# ⚠️ 以上是「参考」的时间轴。实际播放时，**只有这套轮回眼特效**会整体乘
#    `红眼放大速度倍率`（当前 0.26 → 快 74%），所以脚本里
#    红眼放大时长 / 白盘延迟 / 白盘时长 都带 × 该倍率；
#    而普通阶段互切的 `时长` 保持原版 2.0s 不变。
#
# ★ 关于元素尺寸的换算（别被「圆 vs 椭圆」绕进去）：
#     写轮眼背景圆孔  = 94 × 94   ← 普通瞳孔贴图也是 94×94
#     轮回眼背景睑裂孔 = 167 × 105 ← 水平比圆孔宽得多
#     轮回眼1.png      = 194 × 194
#   但轮回眼「背景」比「圆孔」宽，是靠它自己在眼眶内平移实现的 ——
#   **两张背景的外框完全一致**（都是 337×202），所以切背景时不会有位移。
#   在 Godot 里两张背景同框同尺寸，直接套 337×202 的节点框即可，
#   不需要为「椭圆」做任何额外缩放。
#
# 实现方式（第二十版）：给轮回眼挂 **圆形裁切 shader**，半径由 `_扩张进度`
# 从 0.5px 补间到 白盘终半径 —— 视觉上就是白盘从中心向外把红眼吃掉，
# 而边缘是 shader 里 smoothstep 算出来的**平滑抗锯齿**边。
# 圆心 = 轮回眼的 pivot（内容中心）= 12 只瞳孔的圆心，保证严格同心。
# ⚠️ 第十八~十九版用的是 clip_children 遮罩壳 + scale 补间：那是硬裁剪，
#    遮罩还被非整数缩放两次 → 边缘量化成 2~3px 台阶，已被本版替换。
# ★ 第四版起：不再需要「旧眼反向挖空壳」——
#   轮回眼已被提到旧眼之上（见 _把立绘组压到轮回眼之下()），
#   不透明的圆盘从中心长出来天然就把红眼盖掉。
# ============================================================

# ── 时序参数（红眼放大 与 白盘扩张 必须**同时发生**）──────────────
#
# ★ 第五版修正的教训：最初的写法把红眼做成「一上来就明显在长」（QUAD/EASE_IN），
#   而白盘到 1.55s 才起手 —— 结果白盘起手那一刻红眼已经长到 1.60 倍（全程 70%），
#   观感变成「红眼先长完、轮回眼才姗姗来迟」，完全不是「挤出去」。
#
# ★ 参考实测的真实节奏（这才是「同时」）：
#     0.00~1.40s  红眼 36.0 → 40.0px  ← 只涨 11%，几乎看不出在动（蓄力）
#     1.40~1.65s  红眼 40.0 → 46.5px  ← 开始爆发
#     1.65~2.13s  白盘 0 → 67px       ← 与红眼的爆发段**完全重叠**
#     2.20s       红眼被挤出眼眶、白盘占满
#   即：红眼的后置爆发段与白盘的扩张段同起同落，两者一起结束。
#
# 实现：红眼用 TRANS_QUART + EASE_IN（比 QUAD 更后置：前 1/3 几乎不动），
# 白盘在红眼只长了约 1% 时起手，两者同时收尾。
#
# 红眼放大：1.00 → 1.85。94px × 1.85 = 174px，超过睑裂宽度 166px，
# 所以终态会被睑裂完整裁切 —— 这才有「被挤出眼眶」的切边感。
# 想更强就把 红眼终点缩放 调到 2.0~2.2（切得更狠），想更收敛就调回 1.7。
const 红眼起始缩放 := 1.00
const 红眼终点缩放 := 1.85
const 红眼放大时长 := 1.95 * 红眼放大速度倍率     # 写轮眼（红眼）变大：→ 当前 0.51s
# 红眼用 QUAD + EASE_IN：起手很缓（蓄力感）、末尾爆发。
# 缓动太平（SINE/LINEAR）会让白盘起手时红眼已长掉大半，退回「红眼先长完才轮到轮回眼」。
const 红眼缓动 := Tween.TRANS_QUAD

# 白盘（圆形裁切 shader 的半径）扩张 —— 即「轮回眼变大」。
# ★ 第二十七版试做：与红眼**同时起手、同长同短**（见下面 const 处的开关说明）。
#   两者缓动形状相同（QUAD+EASE_IN）→ 进度严格同步 = 「一起放大」。
#
# ── 以下为参考录影的**旧节奏**（第二十七版之前的设定），要回退时照它改：
#   · 延迟 0.14s：此时红眼才长了约 3.5%，几乎看不出动过 → 两者「同时」发生
#   · 全程 0.66s：比红眼的 0.78s 晚约 0.02s 收尾 → 稍慢一拍
#   · 缓动与红眼同形状，只把整条曲线往后挪
#   理论曲线（旧节奏、倍率 0.40）：
#     时间   红眼成长%   白盘进度%   落后
#     0.24s   14.1        4.9      -9.2
#     0.36s   31.6       19.8     -11.9
#     0.48s   56.3       44.4     -11.8
#     0.60s   87.9       74.6     -13.3
#     0.64s  100.0       92.7      -7.3   （红眼已长完，白盘还剩最后一截）
#     0.66s    —        100.0             （白盘收尾）
#   ★ 缓动不能比红眼更极端（CUBIC/QUART）：白盘会先躺平再突然爆发，
#     变成「红眼长完了轮回眼才蹦出来」—— 那就是第五版的问题。
# ★ 三个时长都乘 `红眼放大速度倍率`（白盘时长除外，见下）。
# ★ 第二十七版起：**白盘与红眼同时起手**（延迟 0），不再有蓄力等待。
# ★ 第三十一版起：**时长与红眼解绑**，改成固定值 —— 用户要求
#     「只单独改写轮眼的放大速度，不改轮回眼放大速度」。
#     0.70s 就是解绑前的取值（那时 `白盘时长 := 红眼放大时长` = 1.95 × 0.36）。
#   → 现在仍是同时起手，但红眼更快、白盘按原速走，所以**收尾不再同步**
#     （红眼 0.51s 就长完，白盘继续到 0.70s）。
#   ⚠️ 想回到「两者严格同步（一起变大）」：把下面那行改回 `const 白盘时长 := 红眼放大时长`。
const 白盘延迟 := 0.0
const 白盘时长 := 0.70
const 白盘缓动 := Tween.TRANS_QUAD

# ── 轮回眼本体缩放（决定轮廓是否干净）────────────────────────
# 实测：轮回眼2.png 是半径 95~97 的正圆（原尺寸 194px）；
#       轮回眼背景的开孔半径在 52(75/90/285/300°) ~ 92(15°) 之间变化。
#
# ★ 关键：**必须让圆盘在每个方向都盖过开孔**，轮廓才会统一由开孔决定。
#   · 缩放 1.00 → 半径 97 > 开孔最大 92 → 每个方向都被开孔完整裁到
#     → 轮廓 = 开孔（眼眶）的形状，干净统一 ✅
#   · 缩放 0.70 → 半径 67，开孔有些方向 52、有些 92
#     → 窄的方向被开孔切、宽的方向露出圆盘自己的圆弧
#     → 两种边界混在一起 = 你看到的「不规则形状」 ❌
#
# 所以本体固定 1.00（= 素材原本尺寸），全程不变。
# 外圈环纹（素材 r=57 / 74）超过眼眶半高 52，只会露出左右两段弧 —— 这是必然的，
# 不再为了「让环完整」而缩小本体。
const 轮回眼缩放 := 1.00

# ── 白盘的最终半径 ────────────────────────────────────────────
# ★ 轮回眼**永远是等比缩放的正圆**，从不做非等比拉伸 —— 所以素材不存在「变形」。
#   它看起来不是圆，只是因为长大之后**多余部分被 轮回眼背景 的眼眶开孔遮住了**，
#   这是遮挡，不是变形。
# 这个常量是「圆最后长到多大」的旋钮，也是圆形裁切 shader 的半径上限：
#   95.86 → 圆一路长到 95.86px，把 167×106 的眼眶开孔完全盖住，
#           多余部分被开孔遮掉 → 看起来就是「填满眼眶」（默认）
#   52    → 只长到 104px（= 眼眶高度）。会显得只占瞳孔大小，两侧大片眼白
# 想收窄就往下调，但一般不需要 —— 交给背景遮挡即可。
const 白盘终半径 := 95.86 * 轮回眼缩放

# ── 关于轮回眼可见区的形状（第八版结论 + 第二十版修订）────────
# 可见区由**两级**决定：
#   ① 圆形裁切 shader（本版新增）：把圆盘从中心向外「揭开」，边缘平滑抗锯齿
#   ② 「轮回眼背景」的眼眶开孔：盖在圆盘之上，把溢出部分切掉（第十九版恢复）
#
# ★ 试过给轮回眼单独套一层「干净椭圆裁切」，失败了：
#   椭圆必须小于那块不规则开孔才不会露毛边，可一旦变小，
#   椭圆与开孔之间就露出一圈红边/底色 —— 比原来的毛边更难看。
#   所以**不要试图用第二层裁切去修第一层的形状**，要么把第一层做平滑（本版做法），
#   要么去磨 轮回眼背景.png 自己的开孔边缘。

# 圆形裁切用的着色器 —— 替代了第十八~十九版的 clip_children 遮罩壳。
# ★ 为什么换掉：clip_children 是硬裁剪（无抗锯齿），且遮罩贴图被非整数缩放两次，
#   边缘量化成台阶 → 用户看到「像被什么切了 / 不是原本的样子」。
const 圆形裁切着色器 := preload("res://素材/界面/原版窗口/人物/血继界限/脚本/轮回眼圆形裁切.gdshader")
var _裁切材质: ShaderMaterial     # 挂在 轮回眼立绘.material 上，由 _应用扩张() 驱动
var _扩张进度: float = 0.0:
	set(值):
		_扩张进度 = 值
		_应用扩张()

func _播放轮回眼生长特效() -> void:
	_轮回眼特效中 = true

	# 旧眼（红眼）：保持全不透明，在 1.85s 内放大到 1.85 倍。
	#
	# ★ 为什么不再需要「反向圆挖空壳」：
	#   本版把「轮回眼」提到了「写轮眼背景」**之上**（见 _把立绘组压到轮回眼之下()），
	#   轮回眼圆盘本身不透明，它从中心长出来时天然就把红眼从内向外盖掉——
	#   这正是参考里「红眼被从中心啃掉」的效果。多套一层挖空壳纯属重复。
	#   反过来在旧层级下它是必需的（那时轮回眼被 93px 圆孔卡住，盖不住红眼）。
	#
	# ★ 不旋转：三勾玉的三次谐波相位复核过，没有可信的旋转证据。
	if _旧瞳孔 != null and is_instance_valid(_旧瞳孔):
		_旧瞳孔.visible = true
		_旧瞳孔.modulate.a = 1.0
		_旧瞳孔.rotation_degrees = 0.0
		_旧瞳孔.scale = Vector2.ONE * 红眼起始缩放
		_旧瞳孔.z_index = 0

	var 眼 := 轮回眼立绘
	if 眼 == null:
		_轮回眼特效中 = false
		return

	# 轮回眼：本体不做 scale 动画（那会连同心环一起缩放，观感是「弹一下」），
	# 改成「本体始终 1:1、由遮罩控制露出多少」—— 这才是录屏里
	# 「同心环纹路从中心一圈圈展开」的效果。
	眼.visible = true
	眼.modulate.a = 1.0
	# ★ 固定缩放（全程不变），让三圈环纹都落在眼眶高度之内 → 都能显示成完整的圆。
	#   千万不要改成「从 0 补间到 1」—— 那就变成整张图从小到大缩放，环纹会往外滑。
	眼.scale = Vector2.ONE * 轮回眼缩放
	眼.rotation_degrees = 0.0

	_确保裁切材质()
	_扩张进度 = 0.0
	_应用扩张()

	_tween = create_tween()
	_tween.set_parallel(true)

	# ① 红眼放大（写轮眼变大）：`红眼放大时长`（= 1.95 × 红眼放大速度倍率，
	#    当前 0.51s），QUAD+EASE_IN —— 起手很缓（蓄力），末尾爆发。
	#    ⚠️ 这一段放大时的抖动：原因与可选解法见交接文档「已知问题 1」
	#       （本版不做处理，保持素材原样）。
	#    红眼必须**领先**白盘：它要一边继续长大、一边被白盘往外挤，
	#    这样才有「挤出眼眶」的动感。若白盘反超，红眼只会被平白盖住。
	if _旧瞳孔 != null and is_instance_valid(_旧瞳孔):
		_tween.tween_property(_旧瞳孔, "scale", Vector2.ONE * 红眼终点缩放, 红眼放大时长)\
			.set_trans(红眼缓动).set_ease(Tween.EASE_IN)

	# ② 白盘扩张（轮回眼变大）：延迟 `白盘延迟`(0)、时长 `白盘时长`(固定 0.70s)
	#    —— 与红眼**同时起手**，但时长不跟红眼联动（第三十一版解绑），
	#    所以红眼先长完、白盘按原速继续到 0.70s。
	_tween.tween_property(self, "_扩张进度", 1.0, 白盘时长)\
		.set_delay(白盘延迟).set_trans(白盘缓动).set_ease(Tween.EASE_IN)

	# 收尾：等放大 + 扩张都跑完
	_tween.chain().tween_interval(0.02)
	_tween.chain().tween_callback(_轮回眼特效结束)


func _应用扩张() -> void:
	# 把「扩张进度 0→1」映射成「圆形裁切的半径 0→白盘终半径」。
	# 因为轮回眼画在旧眼之上且不透明，这个圆一变大，
	# 视觉上就是白盘从圆心向外把红眼吃掉 —— 不需要再维护第二个「挖空壳」。
	#
	# ★ 半径下限取 0.5px 而不是 0：半径 0 时整张图 alpha 全 0（会被裁光），
	#   动画第一帧会闪一下「眼睛不见了」。0.5px 在屏幕上只是一个点，
	#   配合 1.65 秒的扩张完全看不出「从 0.5 长起来」的过程。
	# ★ 边缘的平滑由 shader 里的 smoothstep 保证 —— 不再有 clip_children
	#   那种「非整数缩放 + 硬裁剪」造成的台阶锯齿。
	var 半径 := maxf(_扩张进度 * 白盘终半径, 0.5)
	if is_instance_valid(_裁切材质):
		_裁切材质.set_shader_parameter("u_radius", 半径)


# 给「轮回眼」挂上圆形裁切材质（幂等：已经建好就直接返回）。
#
# ★ 为什么改成材质（第二十版，替代第十八~十九版的 clip_children 遮罩壳）：
#   1) clip_children 是**硬裁剪**，边缘没有抗锯齿；
#   2) 遮罩贴图还被非整数缩放了两次（`_造实心圆(256)` 装进 194 的框 = ×0.758，
#      再乘扩张进度），1 像素宽的过渡带被压到不足 1 像素 → 边界量化成 2~3px 台阶。
#   用户看到的就是「边缘像被什么切过一样 / 不是素材原本的样子」。
#   shader 在片元里用 smoothstep 算距离 → 边缘天然平滑，且与缩放无关。
#
# ★ 顺带删掉了原来那次 reparent：轮回眼现在是 写轮眼内容 的直接子节点，
#   层级 = 场景文件里本来就有的顺序（底图 → 写轮眼背景 → 轮回眼 → 轮回眼背景 → UI），
#   不再有「打断动画时坐标还原不全」的隐患。
#
# ★ 材质只控制「露出多少」，圆盘贴图本身一动不动 —— 所以素材原本的样子
#   （含它自带的柔和外沿）被完整保留，这正是本次要的效果。
func _确保裁切材质() -> void:
	if is_instance_valid(_裁切材质):
		return
	if 轮回眼立绘 == null:
		return
	var 尺寸 := 194.0
	if 轮回眼立绘.texture != null:
		尺寸 = float(轮回眼立绘.texture.get_size().x)
	_裁切材质 = ShaderMaterial.new()
	_裁切材质.shader = 圆形裁切着色器
	_裁切材质.set_shader_parameter("u_tex_size", 尺寸)
	_裁切材质.set_shader_parameter("u_center", 轮回眼内容中心)
	_裁切材质.set_shader_parameter("u_edge", 1.2)
	_裁切材质.set_shader_parameter("u_radius", 0.5)
	轮回眼立绘.material = _裁切材质


func _轮回眼特效结束() -> void:
	_轮回眼特效中 = false
	if 轮回眼立绘 != null and is_instance_valid(轮回眼立绘):
		轮回眼立绘.rotation_degrees = 0.0
		轮回眼立绘.modulate.a = 1.0
		轮回眼立绘.visible = true
	_扩张进度 = 1.0
	_应用扩张()
	if _旧瞳孔 != null and is_instance_valid(_旧瞳孔):
		_旧瞳孔.visible = false
		_旧瞳孔.scale = Vector2.ONE          # ★ 必须复位：这一轮它放大到了 1.85 倍
		_旧瞳孔.modulate.a = 1.0
		_旧瞳孔.rotation_degrees = 0.0
	_旧瞳孔 = null
	_新瞳孔 = null
	_进度 = 0.0

	# ★ 白盘已经长到盖住整个开孔，两侧不再需要 写轮眼背景 补眼白，
	#   这时才安全地撤掉它（连同它下面的立绘组）。
	#   顺序不能提前：提前撤 → 旧眼跟着消失，扩张动画就白做了。
	if _当前阶段 == _轮回眼索引:
		if 写轮眼背景 != null:
			写轮眼背景.visible = false
		if 轮回眼背景 != null:
			轮回眼背景.visible = true



func _应用到瞳孔() -> void:
	# 原版 RotateFade.nowTimeGone setter 的 4 行，逐一对应（:39-42）
	var p := _进度
	if _旧瞳孔 != null and is_instance_valid(_旧瞳孔):
		_旧瞳孔.modulate.a = 1.0 - p
		_旧瞳孔.rotation_degrees = 总旋转 * p
	if _新瞳孔 != null and is_instance_valid(_新瞳孔):
		_新瞳孔.modulate.a = p
		_新瞳孔.rotation_degrees = 总旋转 * (1.0 - p)


func _打断当前动画() -> void:
	# 原版 end()：kill 补间 → 移除旧眼 → 新眼归位
	if _tween != null and _tween.is_valid():
		_tween.kill()
	_tween = null
	# ★ 若上一轮跑的是轮回眼特效，这里必须把遮罩扩张进度一起复位，
	#   否则中途打断会留下一个「扩张到一半」的轮回眼。
	if _轮回眼特效中:
		_轮回眼特效中 = false
		if 轮回眼立绘 != null and is_instance_valid(轮回眼立绘):
			轮回眼立绘.rotation_degrees = 0.0
			轮回眼立绘.modulate.a = 1.0
		if _旧瞳孔 != null and is_instance_valid(_旧瞳孔):
			_旧瞳孔.scale = Vector2.ONE          # ★ 旧眼可能正放大到一半，必须复位
			_旧瞳孔.rotation_degrees = 0.0
		# 被打断时不强改 _扩张进度：紧接着的 _应用背景() 会按新阶段决定
		# （切走 → 复位到 0；仍留在轮回眼 → 保持满扩张）。
	if _新瞳孔 != null and is_instance_valid(_新瞳孔):
		_新瞳孔.modulate.a = 1.0
		_新瞳孔.rotation_degrees = 0.0
		_新瞳孔.z_index = 0
		_新瞳孔.scale = Vector2.ONE
	if _旧瞳孔 != null and is_instance_valid(_旧瞳孔):
		_旧瞳孔.visible = false
		_旧瞳孔.scale = Vector2.ONE
	_旧瞳孔 = null
	_进度 = 0.0


func _动画结束() -> void:
	# 终点值精确归位（原版 end() 里 target2.alpha=1 / rotation=0 / removeTarget1）
	if _新瞳孔 != null and is_instance_valid(_新瞳孔):
		_新瞳孔.modulate.a = 1.0
		_新瞳孔.rotation_degrees = 0.0
		_新瞳孔.z_index = 0
	if _旧瞳孔 != null and is_instance_valid(_旧瞳孔):
		_旧瞳孔.visible = false
		_旧瞳孔.modulate.a = 1.0
		_旧瞳孔.rotation_degrees = 0.0
	_旧瞳孔 = null


func _同步按钮状态(选中索引: int) -> void:
	# 只驱动原生状态，不碰 modulate / self_modulate
	for i in _按钮列表.size():
		var 按钮 := _按钮列表[i]
		if not is_instance_valid(按钮):
			continue
		# 保险：清掉任何先前版本残留的 modulate 覆盖
		if 按钮.modulate != Color(1, 1, 1, 1):
			按钮.modulate = Color(1, 1, 1, 1)
		if 按钮.toggle_mode:
			按钮.button_pressed = (i == 选中索引)


func _on_按钮被点击(编号: int) -> void:
	_切换阶段(编号)
