shader_type canvas_item;

// ============================================================
// 轮回眼「白盘扩张」—— 圆形裁切（平滑边缘版）
// ------------------------------------------------------------
// 用法：挂在「轮回眼」TextureRect 的 material 上，用一个**平滑的圆**把
//       194px 的圆盘从中心往外「揭开」，替代原先的 clip_children 遮罩壳。
//
// ★ 为什么要换掉 clip_children（第二十版，2026-09-24）：
//   clip_children 是**硬裁剪**（二进制遮罩，不带抗锯齿），而且遮罩贴图
//   被缩放了两次非整数（`_造实心圆(256)` 装进 194 的框 = ×0.758，
//   再乘扩张进度），1 像素宽的抗锯齿带被压到不足 1 像素
//   → 边缘量化成 2~3px 的台阶。放大 6 倍看就是一齿轮状的锯口，
//   用户描述为「像被什么切了一样 / 不是原本的样子」。
//
// ★ 本 shader 在**片元里按距离算 alpha**：圆外 alpha=0、圆内 alpha=1，
//   中间用 smoothstep 过渡 → 边缘天然抗锯齿，且与缩放无关（不会被
//   非整数缩放压掉过渡带）。圆盘贴图本身（含它自带的柔和外沿）完全不动，
//   所以「素材原本的样子」得以保留。
//
// 参数由 `写轮眼切换_修正版.gd` 驱动：
//   u_radius ← 白盘终半径 × 扩张进度（0 → 95.86）
// ============================================================

// 当前可见半径（贴图像素）。脚本每帧写它。
uniform float u_radius : hint_range(0.0, 220.0) = 220.0;
// 抗锯齿过渡宽度（贴图像素）。1.2 ≈ 视觉上 1px 宽的柔边。
uniform float u_edge : hint_range(0.3, 8.0) = 1.2;
// 贴图边长（轮回眼2.png = 194）
uniform float u_tex_size = 194.0;
// 圆盘内容中心（贴图像素坐标，与 pivot_offset / 轮回眼内容中心 一致）
uniform vec2 u_center = vec2(97.0, 97.0);

void fragment() {
	vec2 p = UV * u_tex_size;
	float d = length(p - u_center);
	// 圆内原样保留，圆外淡出到 0；过渡带 = u_edge，天然抗锯齿
	COLOR.a *= 1.0 - smoothstep(u_radius - u_edge, u_radius, d);
}
